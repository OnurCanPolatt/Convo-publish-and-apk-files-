@page "/register"
@model Convo.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Üye ol";
    Layout = "_LoginLayout";
}

<div class="login-page">
    <div class="login-box">

        <!-- Başlık -->
        <div class="text-center mb-2">
            <h2>Hesap Oluştur</h2>
        </div>

        <!-- Form -->
        <form method="post">
            @Html.AntiForgeryToken()

            <!-- 2'li Grid -->
            <div class="row">
                <div class="col-6">
                    <div class="mb-2">
                        <label asp-for="Input.FirstName" class="form-label">Ad</label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Adınız" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-2">
                        <label asp-for="Input.LastName" class="form-label">Soyad</label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="Soyadınız" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Kullanıcı Adı -->
            <div class="mb-2">
                <label asp-for="Input.UserName" class="form-label">Kullanıcı Adı</label>
                <input asp-for="Input.UserName" class="form-control" placeholder="Kullanıcı Adınız" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="mb-2">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" type="email" class="form-control" placeholder="Email adresiniz" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Telefon -->
            <div class="mb-2">
                <label asp-for="Input.PhoneNumber" class="form-label">Telefon</label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefon Numaranız" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Şifre -->
            <div class="mb-2">
                <label asp-for="Input.Password" class="form-label">Şifre</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Şifreniz" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-7">
                    <div class="mb-2">
                        <label asp-for="Input.Country" class="form-label">Ülke</label>
                        <input asp-for="Input.Country" class="form-control" placeholder="Ülkeniz" />
                        <span asp-validation-for="Input.Country" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-5">
                    <div class="mb-2">
                        <label asp-for="Input.City" class="form-label">Şehir</label>
                        <input asp-for="Input.City" class="form-control" placeholder="Şehriniz" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Cinsiyet ve Yaş - 2'li Grid -->
            <div class="row">
                <div class="col-7">
                    <div class="mb-2">
                        <label asp-for="Input.Gender" class="form-label">Cinsiyet</label>
                        <select asp-for="Input.Gender" class="form-control">
                            <option value="">Seçiniz...</option>
                            <option value="Kadın">Kadın</option>
                            <option value="Erkek">Erkek</option>
                        </select>
                        <span asp-validation-for="Input.Gender" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-5">
                    <div class="mb-2">
                        <label asp-for="Input.Age" class="form-label">Yaş</label>
                        <input asp-for="Input.Age" type="number" min="13" max="120" class="form-control" placeholder="Yaşınız" />
                        <span asp-validation-for="Input.Age" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Giriş Butonu -->
            <button type="submit" class="btn btn-primary w-100 mt-2">Üye Ol</button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .login-page {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 5px 0; /* Daha az padding */
    }

    .bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 1rem;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        width: 100%;
        max-width: 420px; /* Biraz daha geniş grid için */
        position: relative;
        z-index: 1;
        max-height: 98vh; /* Daha fazla alan kullan */
        overflow: hidden; /* Scroll'ı kaldır */
    }

        .login-box h2 {
            color: #667eea;
            font-weight: bold;
            margin-bottom: 0.3rem; /* Çok az boşluk */
            font-size: 1.3rem;
        }

    .btn-primary {
        background: #667eea;
        border: none;
        padding: 0.5rem; /* Daha küçük buton */
    }

        .btn-primary:hover {
            background: #5a6fd8;
        }

    /* Form alanları arası boşlukları çok azalt */
    .mb-2 {
        margin-bottom: 0.4rem !important; /* Çok az boşluk */
    }

    /* Label'ları küçült ve boşluğu azalt */
    .form-label {
        font-size: 0.8rem; /* Daha küçük font */
        margin-bottom: 0.1rem; /* Çok az boşluk */
        font-weight: 500;
    }

    /* Input'ları küçült */
    .form-control, .form-select {
        padding: 0.35rem 0.5rem; /* Daha küçük padding */
        font-size: 0.8rem; /* Küçük font */
        height: auto;
    }

    /* Validation mesajlarını küçült */
    .text-danger {
        font-size: 0.7rem;
        margin-top: 0.05rem;
    }

    /* Grid için */
    .row {
        margin-left: -5px;
        margin-right: -5px;
    }

    .col-5, .col-6, .col-7 {
        padding-left: 5px;
        padding-right: 5px;
    }
</style>