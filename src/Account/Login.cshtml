@page "/login"
@model Convo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_LoginLayout";
}

<div class="login-page">
    <div class="login-box">
        <!-- Başlık -->
        <div class="text-center mb-4">
            <h2>Convo</h2>
            <p>Giriş Yapın</p>
        </div>

        <!-- Form -->
        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Email/Username -->
            <div class="mb-3">
                <label asp-for="Input.UsernameOrEmail" class="form-label">Email veya Kullanıcı Adı</label>
                <input asp-for="Input.UsernameOrEmail"
                       class="form-control"
                       placeholder="Email veya kullanıcı adınız" />
                <span asp-validation-for="Input.UsernameOrEmail" class="text-danger"></span>
            </div>

            <!-- Şifre -->
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Şifre</label>
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       placeholder="Şifreniz" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Beni Hatırla -->
            <div class="mb-3 form-check">
                <input asp-for="Input.RememberMe"
                       type="checkbox"
                       class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">
                    Beni Hatırla
                </label>
            </div>

            <!-- Giriş Butonu -->
            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
        </form>

        <!-- Linkler -->
        <div class="text-center mt-3">
            <a href="/forgot-password">Şifremi Unuttum?</a>
            <a href="/register" class="d-block mt-3">Hesap Oluştur</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .login-page {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        width: 100%;
        max-width: 400px;
        position: relative;
        z-index: 1;
    }

        .login-box h2 {
            color: #667eea;
            font-weight: bold;
        }

    .btn-primary {
        background: #667eea;
        border: none;
        padding: 0.75rem;
    }

        .btn-primary:hover {
            background: #5a6fd8;
        }
</style>
@if (TempData["RegisterSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"
         style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
         @TempData["RegisterSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        // 5 saniye sonra otomatik kaybolsun
        setTimeout(function() {
            document.querySelector('.alert-success')?.remove();
        }, 5000);
    </script>
}
@if (TempData["LoginError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert"
         style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
        @TempData["LoginError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <script>
        setTimeout(function() {
            document.querySelector('.alert-danger')?.remove();
        }, 5000);
    </script>
}
