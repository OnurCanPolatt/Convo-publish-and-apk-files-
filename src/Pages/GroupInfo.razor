@page "/groupInfo/{GroupId:guid}"
@using Domain.Entities
@using Domain.Enums
@using Domain.Interfaces
@using System.Text.Json
@using Infrastructure.Services.Events
@using Microsoft.AspNetCore.Components.Forms
@inject EventShop EventShop
@inject IGroupService _groupService
@inject IImageService _imageService
@inject IUserService _userService
@inject IFriendService _friendService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (groupInfo != null)
{
<div class="group-info-panel">

    <div class="header-chat">
        <button class="back-button" @onclick="CloseGroupInfo"> <i class="bi bi-arrow-left"></i> </button>

        <div class="icon" style="@GetProfileImageStyle(groupInfo?.ImageUrl)" @onclick="TriggerFileSelect">
            @if (string.IsNullOrEmpty(groupInfo?.ImageUrl))
            {
                <span>G</span>
            }
        </div>

        @if (isCurrentUserAdmin)
        {
            <InputFile id="fileInput" style="display:none;" OnChange="UploadGroupImage" />
        }
        <div class="group-header-info">
            <p class="name">
                @if (isEditingName)
                {
                    <input @bind="editableName" class="edit-input" />
                    <button class="btn-save" @onclick="SaveNameChange"><i class="bi bi-check"></i></button>
                    <button class="btn-cancel" @onclick="CancelEdit"><i class="bi bi-x"></i></button>
                }
                else
                {
                    @(groupInfo?.Name ?? "Yükleniyor...")
                    @if (isCurrentUserAdmin)
                    {
                        <i class="bi bi-pencil" @onclick="() => StartEditName(groupInfo?.Name)"></i>
                    }
                }
            </p>
            <p class="member-count">@GetMemberCountText()</p>
        </div>
    </div>

    <div class="group-info-content">

        <div class="info-section">
            <div class="section-header">
                <h3>Grup Bilgileri</h3>
            </div>
            <div class="info-item">
                <i class="bi bi-info-circle"></i>
                <div class="info-text">
                    <span class="label">Açıklama</span>
                    @if (isEditingDescription)
                    {
                        <textarea class="edit-textarea" @bind="editableDescription"></textarea>
                        <div class="edit-actions">
                            <button class="btn-save" @onclick="SaveDescriptionChange"><i class="bi bi-check"></i></button>
                            <button class="btn-cancel" @onclick="CancelEdit"><i class="bi bi-x"></i></button>
                        </div>
                    }
                    else
                    {
                        <span class="value">
                            @(groupInfo?.Description ?? "Açıklama yok")
                            @if (isCurrentUserAdmin)
                            {
                                <i class="bi bi-pencil" @onclick="() => StartEditDescription(groupInfo?.Description)"></i>
                            }
                        </span>
                    }
                </div>
            </div>
            <div class="info-item">
                <i class="bi bi-calendar"></i>
                <div class="info-text">
                    <span class="label">Oluşturulma</span>
                    <span class="value">@groupInfo?.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        </div>

        <div class="participants-section">
            <div class="section-header">
                <h3>Üye Ekle</h3>
                @if (isCurrentUserAdmin)
                {
                    <button class="btn-add-member" @onclick="OpenAddMemberModal">
                        <i class="bi bi-person-plus"></i>
                    </button>
                }
            </div>
        </div>

        <div class="participants-section">
            <div class="section-header">
                <h3>Katılımcılar (@(activeMembers?.Count ?? 0))</h3>
            </div>

            <div class="participants-list">
                @if (activeMembers != null && activeMembers.Any())
                {
                    @foreach (var member in activeMembers)
                    {
                        <div class="participant-item">
                            <div class="participant-photo" style="@GetProfileImageStyle(GetMemberProfileImage(member.UserId))">
                                @if (LayoutData?.OnlineUsers?.Contains(member.UserId.ToString()) == true)
                                {
                                    <div class="online"></div>
                                }
                            </div>

                            <div class="participant-info">
                                <span class="participant-name">@member.User?.UserName</span>

                                @if (member.UserId == groupInfo?.CreatedByUserId)
                                {
                                    <span class="admin-badge owner">Kurucu</span>
                                }
                                else if (member.Role == ChatRoomRole.Admin)
                                {
                                    <span class="admin-badge">Admin</span>
                                }
                            </div>

                            @if (isCurrentUserAdmin)
                            {
                                @if (member.UserId != groupInfo?.CreatedByUserId)
                                {
                                    <div class="participant-actions dropdown">
                                        <i class="bi bi-three-dots-vertical dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"></i>
                                        <ul class="dropdown-menu">
                                            @if (member.Role == ChatRoomRole.Admin)
                                            {
                                                <li>
                                                    <a class="dropdown-item" @onclick="@(() => ChangeMemberRole(member, false))">
                                                        <i class="bi bi-person-dash text-primary"></i> Üye yap
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a class="dropdown-item" @onclick="@(() => ChangeMemberRole(member, true))">
                                                        <i class="bi bi-shield-check text-primary"></i> Admin yap
                                                    </a>
                                                </li>
                                            }

                                            @if (member.UserId != groupInfo?.CreatedByUserId)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" @onclick="@(() => RemoveMemberFromGroup(member))">
                                                        <i class="bi bi-person-x-fill"></i> <strong>Gruptan At</strong>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="no-participants"><p>Katılımcı bulunamadı</p></div>
                }
            </div>
        </div>

        <div class="settings-section">
            <button class="settings-button danger" @onclick="LeaveGroup">
                <i class="bi bi-box-arrow-right"></i>
                <span>Gruptan Ayrıl</span>
            </button>
            @if (groupInfo?.CreatedByUserId == myId)
            {
                <button class="settings-button danger" @onclick="DeleteGroup">
                    <i class="bi bi-trash"></i>
                    <span>Grubu Sil</span>
                </button>
            }
        </div>
    </div>
</div>
}
else
{
    <div class="loading-panel">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
        <p>Grup bilgileri güncelleniyor veya grup silindi...</p>
    </div>
}
@if (showAddMemberModal)
{
    <div class="modal-overlay" @onclick="CloseAddMemberModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4>Gruba Üye Ekle</h4>
                <button class="btn-close" @onclick="CloseAddMemberModal"><i class="bi bi-x"></i></button>
            </div>

            <div class="modal-body">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           placeholder="Arkadaşların arasında ara..."
                           @bind="searchQuery" 
                           @bind:event="oninput" />
                </div>

                <div class="users-list">
                    @if (isSearching)
                    {
                        <div class="loading">Arkadaş listen yükleniyor...</div>
                    }
                    else if (searchResults != null && searchResults.Any())
                    {
                        @foreach (var friendship in searchResults)
                        {
                            var user = GetFriendUser(friendship);
                            <div class="user-item">
                                <div class="user-photo" style="@GetProfileImageStyle(GetUserProfileImage(user.Id))"></div>
                                <div class="user-info">
                                    <span class="user-name">@user.UserName</span>
                                    <span class="user-email">@user.Email</span>
                                </div>
                                <button class="btn-add" @onclick="() => AddMemberToGroup(user.Id)">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <div class="no-results">Aramayla eşleşen arkadaş bulunamadı.</div>
                    }
                    else
                    {
                        <div class="no-results">Gruba eklenecek arkadaş bulunamadı.</div>
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {
    [CascadingParameter(Name = "LayoutData")] public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }
    [Parameter] public Guid GroupId { get; set; }

    private ChatRoom? groupInfo;
    private List<ChatRoomMember>? activeMembers;
    private Guid myId;
    private bool isCurrentUserAdmin = false;
    private Dictionary<Guid, string> memberProfileImages = new();

    // edit durumları
    private bool isEditingName = false;
    private bool isEditingDescription = false;
    private string editableName = string.Empty;
    private string editableDescription = string.Empty;

    // --- ÜYE EKLEME MODALI İÇİN YENİ YAPI ---
    private bool showAddMemberModal = false;
    private string searchQuery = string.Empty;
    private List<Friend> searchResults = new();         // ✅ Düzeltme: Arama sonuçları Friend tipinde
    private List<Friend> allMyFriends = new();          // ✅ Yeni: Tüm arkadaşları tutan ana liste
    private bool isSearching = false;
    private Dictionary<Guid, string> userProfileImages = new();
    private readonly object _imageLock = new();
    
    private bool _isProcessing = false;
    
    private EventHandler? _groupInfoHandler;
    private EventHandler? _userInfoUpdateHandler;


    // ✅ Yeni: Friend nesnesinden doğru AppUser'ı (arkadaş olan kişiyi) döndüren yardımcı metot
    private AppUser GetFriendUser(Friend friendship)
    {
        return friendship.UserId == myId ? friendship.FriendUser : friendship.User;
    }
    // --- BİTİŞ ---

    protected override async Task OnInitializedAsync()
    {
        _groupInfoHandler = async (s, e) => await HandleUpdateGroupInfoAsync(s, e);
        EventShop.OnGroupInfoUpdated += _groupInfoHandler;

        // ✅ YENİ: MessageList'teki gibi profil güncellemelerini dinle
        _userInfoUpdateHandler = async (s, e) => await HandleUserProfileUpdate(s, e);
        EventShop.OnUserInfoUpdated += _userInfoUpdateHandler;

        await LoadGroupData();
    }
    // ✅ YENİ: MessageList.razor'daki gibi basit event handler
    private async Task HandleUserProfileUpdate(object? sender, EventArgs e)
    {
        try
        {
            Console.WriteLine("📸 GroupInfo: Profil güncelleme eventi alındı");

            // 1. MainLayout zaten LayoutData.ProfileImages'ı güncelledi
            // 2. Sadece memberProfileImages cache'ini senkronize et
            if (LayoutData?.ProfileImages != null && activeMembers != null)
            {
                foreach (var member in activeMembers)
                {
                    if (LayoutData.ProfileImages.TryGetValue(member.UserId, out var updatedUrl))
                    {
                        // Cache'i güncelle
                        memberProfileImages[member.UserId] = updatedUrl;
                    }
                }
            }

            // 3. UI'ı güncelle
            await InvokeAsync(StateHasChanged);

            Console.WriteLine("✅ GroupInfo: Profil fotoğrafları senkronize edildi");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ HandleUserProfileUpdate hatası: {ex.Message}");
        }
    }



    private async Task LoadGroupData()
    {
        try
        {
            var currentUser = await _userService.GetCurrentUserAsync();
            if (currentUser == null) return;
            myId = currentUser.Id;

            groupInfo = await _groupService.GetFreshGroupInfo(GroupId);

            if (groupInfo != null)
            {
                activeMembers = groupInfo.Members?.Where(m => m.IsActive).ToList() ?? new List<ChatRoomMember>();
            
                // 🚨 DEĞİŞİKLİK: Adminlik kontrolünü garantileyelim
                var myMemberEntry = activeMembers.FirstOrDefault(m => m.UserId == myId);
            
                // Log atalım, F12 Console'da ne yazdığına bak:
                bool isOwner = groupInfo.CreatedByUserId == myId;
                bool isAdminRole = myMemberEntry?.Role == ChatRoomRole.Admin;
                isCurrentUserAdmin = isOwner || isAdminRole;

                Console.WriteLine($"🔍 ADMIN CHECK -> Owner: {isOwner}, Role: {myMemberEntry?.Role}, Result: {isCurrentUserAdmin}");

                memberProfileImages.Clear();
                await LoadMemberProfileImages();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Hata: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }
// ✅ YENİ: Önbellekten okuyan versiyon
    private async Task LoadMemberProfileImages()
    {
        if (activeMembers == null || LayoutData == null)
        {
            memberProfileImages = new Dictionary<Guid, string>();
            return;
        }

        Console.WriteLine($"🖼️ {activeMembers.Count} üyenin fotoğrafı önbellekten yükleniyor...");

        var tempImages = new Dictionary<Guid, string>();
        
        // 1. Gruptaki tüm üyelerin fotoğraflarını 'LayoutData' önbelleğinden ara
        foreach (var member in activeMembers)
        {
            if (LayoutData.ProfileImages.TryGetValue(member.UserId, out var cachedUrl))
            {
                // HIZLI YOL: Önbellekte bulundu
                tempImages[member.UserId] = cachedUrl;
            }
            else
            {
                // YAVAŞ YOL (Yedek Plan): Önbellekte yok, DB/MinIO'dan çek ve önbelleğe ekle
                try
                {
                    var dbUrl = await _imageService.GetImageThumbnailUrlAsync(member.UserId);
                    tempImages[member.UserId] = dbUrl;
                    LayoutData.ProfileImages[member.UserId] = dbUrl; // Gelecek için önbelleğe ekle
                }
                catch
                {
                    tempImages[member.UserId] = "/images/default-avatar.png";
                }
            }
        }
        
        memberProfileImages = tempImages;
        Console.WriteLine($"✅ {memberProfileImages.Count} üye fotoğrafı yüklendi.");
    }

    private string GetProfileImageStyle(string? imageUrl)
        => string.IsNullOrEmpty(imageUrl)
            ? "background-color:#007bff;"
            : $"background-image:url('{imageUrl}');background-size:cover;background-position:center;";

    private string GetMemberProfileImage(Guid userId)
        => memberProfileImages.TryGetValue(userId, out var url) ? url : "/images/default-avatar.png";

    private string GetMemberCountText() => $"{activeMembers?.Count ?? 0} üye";

    private void CloseGroupInfo() => NavigationManager.NavigateTo($"/groupChat/{GroupId}");


    // === DÜZENLEME METOTLARI (DEĞİŞİKLİK YOK) ===
    private void StartEditName(string? current)
    {
        editableName = current ?? "";
        isEditingName = true;
    }

    private void StartEditDescription(string? current)
    {
        editableDescription = current ?? "";
        isEditingDescription = true;
    }

    private void CancelEdit()
    {
        isEditingName = false;
        isEditingDescription = false;
    }

    private async Task SaveNameChange()
    {
        if (groupInfo == null) return;
        await _groupService.UpdateGroupInfo(groupInfo.Id, editableName, groupInfo.Description ?? "", groupInfo.ImageUrl ?? "");
        groupInfo.Name = editableName;
        isEditingName = false;
        
        await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
    }

    private async Task SaveDescriptionChange()
    {
        try
        {
            if (groupInfo == null) return;
            await _groupService.UpdateGroupInfo(groupInfo.Id, groupInfo.Name, editableDescription, groupInfo.ImageUrl ?? "");
            groupInfo.Description = editableDescription;
            isEditingDescription = false;

            await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);

        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }

    }

    private async Task UploadGroupImage(InputFileChangeEventArgs e)
    {
        if (groupInfo == null) return;

        var file = e.File;
        var fileInput = new Domain.Models.Download.FileInput
        {
            FileName = file.Name,
            ContentType = file.ContentType,
            Size = file.Size,
            OpenStream = (maxSize) => file.OpenReadStream(maxSize)
        };
        var uploadedUrl = await _imageService.UploadGroupImageAsync(fileInput, groupInfo.Id);
        if (!string.IsNullOrEmpty(uploadedUrl))
        {
            groupInfo.ImageUrl = uploadedUrl;
            await _groupService.UpdateGroupInfo(groupInfo.Id, groupInfo.Name, groupInfo.Description ?? "", uploadedUrl);
            try
            {

                await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
                await InvokeAsync(StateHasChanged);
            }
            catch (JSException ex)
            {
                Console.WriteLine($"⚠️ JS callback bulunamadı: {ex.Message}");
            }
        }
    }

    private async Task ChangeMemberRole(ChatRoomMember member, bool isAdmin)
    {
        if (groupInfo == null || member == null) return;

        var result = await _groupService.UpdateMemberAdminStatus(groupInfo.Id, member.UserId, isAdmin);

        if (result)
        {
            member.Role = isAdmin ? ChatRoomRole.Admin : ChatRoomRole.Member;
            EventShop.TriggerOnGroupInfoUpdated();
            await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TriggerFileSelect()
    {
        if (isCurrentUserAdmin) await JSRuntime.InvokeVoidAsync("triggerFileInputClick", "fileInput");
    }

    private async Task LeaveGroup()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("showConfirmDialog",
            "Gruptan Ayrılmak İstediğinize Emin misiniz?",
            "Gruptan ayrılacaksınız!");
        if (!confirmed) return;

        var success = await _groupService.LeaveGroup(GroupId, myId);
        if (!success) return ;
        

        await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
        
        NavigationManager.NavigateTo("/home");

    }

    private async Task DeleteGroup()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("showConfirmDialog",
            "Bu grubu silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
            "Grubu sileceksiniz!");
        if (!confirmed) return;

        var success = await _groupService.DeleteGroup(GroupId, myId);
       await Task.Delay(100);
        if (success) NavigationManager.NavigateTo("/home");
        

        await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
    }

    // === YENİ ÜYE EKLEME MANTIĞI ===
    // ✅ YENİ: Önbellekten okuyan versiyon
    private async Task OpenAddMemberModal()
    {
        showAddMemberModal = true;
        searchQuery = string.Empty;
        searchResults = new();
        isSearching = true;

        // 1. Tüm arkadaşları servisten BİR KEZ çek (Bu doğru)
        allMyFriends = await _friendService.GetMyFriends();

        // 2. Fotoğrafları Yavaşça Yükleyen Bloğu Düzelt
        Console.WriteLine($"🖼️ {allMyFriends.Count} arkadaşın fotoğrafı önbellekten yükleniyor (Modal)...");
        
        foreach (var friend in allMyFriends)
        {
            var user = GetFriendUser(friend);
            if (!userProfileImages.ContainsKey(user.Id))
            {
                if (LayoutData != null && LayoutData.ProfileImages.TryGetValue(user.Id, out var cachedUrl))
                {
                    // HIZLI YOL: Önbellekte bulundu
                    userProfileImages[user.Id] = cachedUrl;
                }
                else
                {
                    // YAVAŞ YOL (Yedek Plan):
                    try
                    {
                        var dbUrl = await _imageService.GetImageThumbnailUrlAsync(user.Id);
                        userProfileImages[user.Id] = dbUrl;
                        if(LayoutData != null) LayoutData.ProfileImages[user.Id] = dbUrl;
                    }
                    catch
                    {
                        userProfileImages[user.Id] = "/images/default-avatar.png";
                    }
                }
            }
        }
        
        // ❌ ESKİ YAVAŞ BLOĞU SİLİN:
        // var loadImageTasks = allMyFriends.Select(async friend =>
        // { ... });
        // await Task.WhenAll(loadImageTasks);

        isSearching = false;
        SearchUsers(); // İlk listeyi (grupta olmayanlar) göstermek için filtrelemeyi çalıştır.
    }

    private void CloseAddMemberModal()
    {
        showAddMemberModal = false;
        allMyFriends = new(); // Belleği temizle
        userProfileImages.Clear();
    }

    // Bu metot artık veritabanına gitmiyor, sadece bellekteki 'allMyFriends' listesini filtreliyor.
    private void SearchUsers()
    {
        if (allMyFriends == null) return;

        var currentMemberIds = activeMembers?.Select(m => m.UserId).ToHashSet() ?? new HashSet<Guid>();
        
        var filteredFriends = allMyFriends
            .Where(friendship => !currentMemberIds.Contains(GetFriendUser(friendship).Id));

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredFriends = filteredFriends
                .Where(friendship =>
                {
                    var user = GetFriendUser(friendship);
                    return user.UserName.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase) ||
                           user.Email.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase);
                });
        }

        searchResults = filteredFriends.ToList(); 
        InvokeAsync(StateHasChanged);
    }

    private async Task AddMemberToGroup(Guid userId)
    {
        var success = await _groupService.AddMembersToGroup(GroupId, new List<Guid> { userId });
        if (success)
        {
            await LoadGroupData(); // Grup bilgisini yeniden yükle
            
            // Eklenen kullanıcıyı ana listeden çıkararak arayüzü anında güncelle
            allMyFriends.RemoveAll(f => GetFriendUser(f).Id == userId); 
            SearchUsers(); // Filtrelenmiş listeyi tekrar göster
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Üye eklenirken bir sorun oluştu.");
        }
        EventShop.TriggerOnGroupInfoUpdated();
        await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
    }

    private string GetUserProfileImage(Guid userId)
        => userProfileImages.TryGetValue(userId, out var url) ? url : "/images/default-avatar.png";
    
  private async Task HandleUpdateGroupInfoAsync(object? sender, EventArgs e)
{
    if (_isProcessing) return;

    try
    {
        _isProcessing = true;
        
        // 🚀 1. DB Çakışmasını önlemek için küçük bir bekleme
        await Task.Delay(200);

        if (groupInfo == null) return;

        // 🚀 2. Taze veriyi çek
        var freshGroup = await _groupService.GetFreshGroupInfo(GroupId);

        // SENARYO A: Grup tamamen silinmişse
        if (freshGroup == null || freshGroup.IsActive == false)
        {
            await RedirectToHome("Grup silindi.");
            return;
        }

        groupInfo = freshGroup;
        activeMembers = groupInfo.Members?.Where(m => m.IsActive).ToList() ?? new List<ChatRoomMember>();

        // 🚀 3. KRİTİK KONTROL: Ben hala üye miyim?
        var currentMember = activeMembers.FirstOrDefault(m => m.UserId == myId);

        // SENARYO B: Ben gruptan atılmışım (Listede yokum)
        if (currentMember == null)
        {
            Console.WriteLine("🚫 Gruptan atıldığınız tespit edildi. Yönlendiriliyorsunuz...");
            await RedirectToHome("Gruptan çıkarıldınız.");
            return;
        }

        // SENARYO C: Hala gruptayım, yetkilerimi güncelle
        bool isOwner = groupInfo.CreatedByUserId == myId;
        bool isAdminRole = currentMember.Role == ChatRoomRole.Admin;
        isCurrentUserAdmin = isOwner || isAdminRole;

        await InvokeAsync(StateHasChanged);
    }
    catch (Exception ex)
    {
        Console.WriteLine($"ℹ️ Senkronizasyon Notu: {ex.Message}");
    }
    finally { _isProcessing = false; }
}

// Yardımcı Yönlendirme Metodu
private async Task RedirectToHome(string reason)
{
    // LayoutData'dan temizle
    if (LayoutData?.myGroups != null)
    {
        var groupToRemove = LayoutData.myGroups.FirstOrDefault(g => g.Id == GroupId);
        if (groupToRemove != null) LayoutData.myGroups.Remove(groupToRemove);
    }

    await InvokeAsync(() => {
        var currentUri = NavigationManager.Uri;
        if (currentUri.Contains(GroupId.ToString()))
        {
            NavigationManager.NavigateTo("/home");
        }
    });
}
    
    private async Task RemoveMemberFromGroup(ChatRoomMember member)
    {
        if (groupInfo == null || member == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("showConfirmDialog",
            $"{member.User?.UserName} kullanıcısını gruptan atmak istediğinize emin misiniz?",
            "Bu işlem geri alınamaz!");

        if (!confirmed) return;

        var success = await _groupService.LeaveGroup(groupInfo.Id, member.UserId);

        if (success)
        {
            // Backend zaten ReceiveUserLeftGroup gönderecek (GroupController'da düzelttik)
            await LoadGroupData(); // Grup bilgisini yeniden yükle
            await JSRuntime.InvokeVoidAsync("window.signalRManager.groupInfoUpdated", GroupId);
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Kullanıcı gruptan atılırken bir hata oluştu.");
        }
    }
    public void Dispose()
    {
        if (_groupInfoHandler != null)
            EventShop.OnGroupInfoUpdated -= _groupInfoHandler;

        // ✅ YENİ: MessageList'teki gibi temizlik
        if (_userInfoUpdateHandler != null)
            EventShop.OnUserInfoUpdated -= _userInfoUpdateHandler;
    }


}