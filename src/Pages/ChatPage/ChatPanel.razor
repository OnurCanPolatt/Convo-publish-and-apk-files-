@page "/chatPanel/{userId:guid}"
@using Domain.Entities
@using Domain.Interfaces
@using Domain.Interfaces.ConferenceInterfaces
@using Domain.Constants
@using Domain.Enums
@using Convo.Shared.Models.Dtos
@using Convo.Shared.Wrappers
@using System.Text.Json
@using Domain.FileDataType
@using Domain.Models.Download
@using Radzen
@using Infrastructure.Services.Events
@using Microsoft.Extensions.Configuration
@inject IImageService imageService
@inject IUserService _userService
@inject IMessageService _messageService
@inject IJSRuntime JSRuntime
@inject ICacheService _cacheService
@inject IDownloadService _downloadService
@inject IConferenceService _conferenceService
@inject HttpClient Http
@inject NotificationService NotificationService
@inject EventShop EventShop
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager NavigationManager

@attribute [Authorize]

<section id="chat-panel-section" class="chat @(isInVideoCall ? "video-call-mode video-call-active" : "")">
    <div class="header-chat">
        <div class="icon" style="background-image: url('@profileImageUrl'); background-size: cover; background-position: center; width: 40px; height: 40px; border-radius: 50%;">
            @if (LayoutData?.OnlineUsers?.Contains(UserId.ToString()) == true)
            {
                <div class="online"></div>
            }
        </div>
        <p class="name">@(userInfo?.UserName ?? "Yükleniyor...")</p>
        @if (!showWaitingCall && !isInVideoCall)
        {
            <div class="call-buttons">
                <i class="bi bi-camera-video-fill clickable" @onclick="StartVideoCall"></i>
            </div>
        }
        else if (showWaitingCall && !isInVideoCall)
        {
            <span><i class="bi bi-telephone-fill clickable"></i> Waiting...</span>
        }

    </div>

    @if (isInVideoCall)
    {
        <div class="video-call-content">
            <div class="video-section">
                <div id="background-video"></div>
                <div id="small-videos"></div>

                <div class="video-controls">
                    <button class="btn-mic @(isMicMuted ? "muted" : "")" @onclick="ToggleMic">
                        <i class="bi @(isMicMuted ? "bi-mic-mute" : "bi-mic")"></i>
                    </button>
                    <button class="btn-camera @(isCameraOff ? "off" : "")" @onclick="ToggleCamera">
                        <i class="bi @(isCameraOff ? "bi-camera-video-off" : "bi-camera-video")"></i>
                    </button>
                    <button class="btn-end" @onclick="EndCall">
                        <i class="bi bi-telephone-x"></i>
                    </button>
                </div>
            </div>

            <div class="chat-section">
                <div class="messages-chat" id="videoMessagesContainer">
                    @{
                        var messagesCopy = Messages;
                    }
                    @if (messagesCopy.Any())
                    {
                        @foreach (var message in messagesCopy)
                        {
                            if (message.SenderId == myId)
                            {
                                <div class="message text-only" data-message-id="@message.Id">
                                    @if (message.Type == MessageType.Text)
                                    {
                                        <TextMessageComponent message="@message" MessageFrom="sent" />
                                    }
                                    else if (message.Type == MessageType.Video)
                                    {
                                        <VideoMessageComponent message="@message" MessageFrom="sent" />
                                    }
                                    else
                                    {
                                        <FileMessageComponent message="@message" MessageFrom="sent" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="message" data-message-id="@message.Id">
                                    <div class="photo" style="@GetProfileImageStyle(profileImageUrl)">
                                        @if (LayoutData?.OnlineUsers?.Contains(UserId.ToString()) == true)
                                        {
                                            <div class="online"></div>
                                        }
                                    </div>

                                    @if (message.Type == MessageType.Text)
                                    {
                                        <TextMessageComponent message="@message" MessageFrom="received" />
                                    }
                                    else if (message.Type == MessageType.Video)
                                    {
                                        <VideoMessageComponent message="@message" MessageFrom="received" />
                                    }
                                    else
                                    {
                                        <FileMessageComponent message="@message" MessageFrom="received" />
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="no-messages"><p>Henüz mesaj yok</p></div>
                    }
                </div>

                @* ✅ File Preview for Video Mode *@
                @if (selectedFile != null)
                {
                    @if (selectedFile != null)
                    {
                        <div class="file-preview video-mode">
                            <div class="file-header">
                                <i class="bi bi-file-earmark file-icon"></i>
                                <div class="file-info">
                                    <div class="file-name">@selectedFile.Name</div>
                                    <div class="file-details">@GetFileSizeString(selectedFile.Size)</div>
                                </div>
                            </div>

                            @if (isUploading)
                            {
                                <div class="upload-progress-section">
                                    <div class="progress-container">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @(uploadProgress)%"></div>
                                        </div>
                                        <div class="progress-text">@uploadStatus - @uploadProgress.ToString("0")%</div>
                                        <div class="upload-stats">
                                            <span>@uploadSpeed</span>
                                            <span>@remainingTime kaldı</span>
                                        </div>
                                    </div>
                                    <div class="upload-actions">
                                        <button class="btn-danger" @onclick="CancelUpload">İptal</button>
                                    </div>
                                </div>
                            }
                            else if (hasUploadError)
                            {
                                <div class="error-message">@uploadErrorMessage</div>
                                <div class="upload-actions">
                                    <button class="btn-warning" @onclick="RetryUpload">Tekrar Dene</button>
                                    <button class="btn-cancel" @onclick="CancelFileSelection">İptal</button>
                                </div>
                            }
                            else
                            {
                                <div class="preview-actions">
                                    <button class="btn-send" @onclick="SendSelectedFile">
                                        <i class="bi bi-send"></i> Gönder
                                    </button>
                                    <button class="btn-cancel" @onclick="CancelFileSelection">
                                        <i class="bi bi-x-lg"></i> İptal
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }

                @* ✅ Chat input *@
                <div class="footer-chat">
                    @* <div class="footer-left-icons"> *@
                    @*     <i class="bi bi-emoji-smile clickable"></i> *@
                    @* </div> *@
                    <input type="text" class="write-message" placeholder="Mesajınızı yazın..."
                           @bind="newMessage" @bind:event="oninput" @onkeydown="HandleKeyPress" />
                    <div class="footer-right-icons">
                        <InputFile id="fileInputVideo" OnChange="HandleFileSelected" style="display: none;" accept="*/*" />
                        <label for="fileInputVideo"><i class="bi bi-file-earmark-post clickable"></i></label>
                        <i class="bi bi-send clickable" @onclick="SendTextMessage"></i>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="messages-chat" id="messagesContainer">
            @{
                var messagesCopy = Messages;
            }
            @if (messagesCopy.Any())
            {
                @foreach (var message in messagesCopy)
                {
                    if (message.SenderId == myId)
                    {
                        <div class="message text-only" data-message-id="@message.Id">
                            @if (message.Type == MessageType.Text)
                            {
                                <TextMessageComponent message="@message" MessageFrom="sent" />
                            }
                            else if (message.Type == MessageType.Video)
                            {
                                <VideoMessageComponent message="@message" MessageFrom="sent" />
                            }
                            else
                            {
                                <FileMessageComponent message="@message" MessageFrom="sent" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="message" data-message-id="@message.Id">
                            <div class="photo" style="@GetProfileImageStyle(profileImageUrl)">
                                @if (LayoutData?.OnlineUsers?.Contains(UserId.ToString()) == true)
                                {
                                    <div class="online"></div>
                                }
                            </div>
                            @if (message.Type == MessageType.Text)
                            {
                                <TextMessageComponent message="@message" MessageFrom="received" />
                            }
                            else if (message.Type == MessageType.Video)
                            {
                                <VideoMessageComponent message="@message" MessageFrom="received" />
                            }
                            else
                            {
                                <FileMessageComponent message="@message" MessageFrom="received" />
                            }
                        </div>
                    }
                }
            }
            else
            {
                <div class="no-messages"><p>Henüz mesaj yok</p></div>
            }
        </div>

        @if (selectedFile != null)
        {
            <div class="file-preview normal-mode">
                <div class="file-header">
                    <i class="bi bi-file-earmark file-icon"></i>
                    <div class="file-info">
                        <div class="file-name">@selectedFile.Name</div>
                        <div class="file-details">@GetFileSizeString(selectedFile.Size)</div>
                    </div>
                </div>

                @if (isUploading)
                {
                    <div class="upload-progress-section">
                        <div class="progress-container">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(uploadProgress)%"></div>
                            </div>
                            <div class="progress-text">@uploadStatus - @uploadProgress.ToString("0")%</div>
                            <div class="upload-stats">
                                <span>@uploadSpeed</span>
                                <span>@remainingTime kaldı</span>
                            </div>
                        </div>
                        <div class="upload-actions">
                            <button class="btn-danger" @onclick="CancelUpload">İptal</button>
                        </div>
                    </div>
                }
                else if (hasUploadError)
                {
                    <div class="error-message">@uploadErrorMessage</div>
                    <div class="upload-actions">
                        <button class="btn-warning" @onclick="RetryUpload">Tekrar Dene</button>
                        <button class="btn-cancel" @onclick="CancelFileSelection">İptal</button>
                    </div>
                }
                else
                {
                    <div class="preview-actions">
                        <button class="btn-send" @onclick="SendSelectedFile">
                            <i class="bi bi-send"></i> Gönder
                        </button>
                        <button class="btn-cancel" @onclick="CancelFileSelection">
                            <i class="bi bi-x-lg"></i> İptal
                        </button>
                    </div>
                }
            </div>
        }

        <div class="footer-chat">
            @* <div class="footer-left-icons"> *@
            @*     <i class="bi bi-emoji-smile clickable"></i> *@
            @* </div> *@
            <input type="text" class="write-message" placeholder="Mesajınızı yazın..."
                   @bind="newMessage" @bind:event="oninput" @onkeydown="HandleKeyPress" />
            <div class="footer-right-icons">
                <InputFile id="fileInput" OnChange="HandleFileSelected" style="display:none" accept="*/*" />
                <label for="fileInput"><i class="bi bi-file-earmark-post clickable"></i></label>
                <i class="bi bi-send clickable" @onclick="SendTextMessage"></i>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }

    [Parameter] public Guid UserId { get; set; }

    // (Değişkenlerin geri kalanı)
    private readonly object _messagesLock = new();
    private List<Message> _messages = new();
    private bool _subscribed = false;
    private bool _jsInitialized = false;
    FileMessageComponent? refFilemsg;

    public List<Message> Messages
    {
        get
        {
            lock (_messagesLock)
                return _messages.ToList();
        }
    }

    public Guid oldUserId { get; set; }
    private Guid myId { get; set; }
    private AppUser myInfo { get; set; } = new();
    private AppUser userInfo { get; set; } = new();
    private string profileImageUrl { get; set; } = "/images/default-avatar.png";
    private string newMessage = "";
    private IBrowserFile? selectedFile;
    private bool isUploading = false;
    private bool hasUploadError = false;
    private double uploadProgress = 0;
    private string uploadStatus = "";
    private string uploadErrorMessage = "";
    private string uploadSpeed = "0 KB/s";
    private string remainingTime = "--:--";
    private bool isInVideoCall = false;
    private bool isMicMuted = false;
    private bool isCameraOff = false;
    private int roomId;
    private string statusMessage = string.Empty;
    private bool showWaitingCall = false;
    
    private Guid currentCallPartnerId;
    private IDisposable? _locationChangingHandler;
    private bool _isDisposing = false;

    // (Thread-safe metotlar)
    private void AddMessageSafely(Message message)
    {
        lock (_messagesLock)
        {
            // 1. Duplicate kontrolü
            if (_messages.Any(m => m.Id == message.Id))
            {
                Console.WriteLine($"⚠️ Duplicate mesaj eklenmedi: {message.Id}");
                return;
            }

            // 2. Mesajı ekle
            _messages.Add(message);

            // 3. ✅ CRITICAL: Tarih bazlı sıralama
            _messages = _messages
                .OrderBy(m => m.SentAt)
                .ThenBy(m => m.Id) // Aynı saniyede gelen mesajlar için ikincil sıralama
                .ToList();
        
            Console.WriteLine($"✅ Mesaj eklendi ve sıralandı. Toplam: {_messages.Count}, Son mesaj: {message.SentAt:o}");
        }
    }


    private void SetMessagesSafely(List<Message> newMessages)
    {
        lock (_messagesLock)
        {
            _messages.Clear();
            _messages.AddRange(newMessages ?? []);
        }
    }

    private void ClearMessagesSafely()
    {
        lock (_messagesLock)
            _messages.Clear();
    }
    protected override void OnInitialized()
    {
        _disposed = false;
        _isDisposing = false;

        // 🚀 Mükerrer aboneliği engellemek için önce çıkar, sonra ekle
        EventShop.OnReceiveMessage -= HandleReceiveMessage;
        EventShop.OnReceiveMessage += HandleReceiveMessage;


        EventShop.OnFriendJoinedConference -= HandleFriendJoined;
        EventShop.OnP2pConferenceEnded -= HandleP2pConferenceEnded;
        EventShop.OnFriendJoinedConference += HandleFriendJoined;
        EventShop.OnP2pConferenceEnded += HandleP2pConferenceEnded;

        // Download Service abonelikleri
        _downloadService.OnUploadProgressChanged -= OnUploadProgressChanged;
        _downloadService.OnUploadStatusChanged -= OnUploadStatusChanged;
        _downloadService.OnUploadError -= OnUploadError;
        _downloadService.OnUploadCompleted -= OnUploadCompleted;
        _downloadService.OnUploadCancelled -= OnUploadCancelled;

        _downloadService.OnUploadProgressChanged += OnUploadProgressChanged;
        _downloadService.OnUploadStatusChanged += OnUploadStatusChanged;
        _downloadService.OnUploadError += OnUploadError;
        _downloadService.OnUploadCompleted += OnUploadCompleted;
        _downloadService.OnUploadCancelled += OnUploadCancelled;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Navigasyon handler kaydı
            _locationChangingHandler = NavigationManager.RegisterLocationChangingHandler(HandleLocationChanging);

            if (!_jsInitialized)
            {
                _jsInitialized = true;
                try
                {
                    var isLocal = HttpContextAccessor.HttpContext?.Request.Host.Host == "localhost" ||
                                  HttpContextAccessor.HttpContext?.Request.Host.Host == "127.0.0.1";

                    var janusUrl = isLocal
                        ? Configuration["Janus:HttpEndpoint"]
                        : Configuration["Janus:ExternalHttpEndpoint"];

                    await JSRuntime.InvokeAsync<bool>("initJanus", janusUrl);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"❌ Janus init hatası: {ex.Message}");
                }
            }

            // Varsa bekleyen konferans katılımı
            var pendingRoomId = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "pendingConferenceRoomId");
            if (!string.IsNullOrEmpty(pendingRoomId) && int.TryParse(pendingRoomId, out var roomId))
            {
                await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "pendingConferenceRoomId");
                await Task.Delay(500); // DOM yerleşimi için kısa bekleme
                await JoinConference(roomId);
            }
        }
    }
    private async ValueTask HandleLocationChanging(LocationChangingContext context)
    {
        // 1. Bir video görüşmesi aktif mi?
        if (isInVideoCall && !_isDisposing)
        {
            // 2. Gidilen YENİ URL, hala /chatPanel/ içinde mi?
            if (context.TargetLocation.Contains("/chatPanel/", StringComparison.OrdinalIgnoreCase))
            {
                // EVET. (Senaryo 1) P2P kullanıcıları arası geçiş yapıyoruz.
                // Aramayı KAPATMA. Devam et.
            }
            else
            {
                // HAYIR. (Senaryo 2) /home gibi farklı bir sayfaya gidiyoruz.
                // Aramayı SONLANDIR.

                Console.WriteLine("Navigasyon YAKALANDI: /chatPanel dışına çıkılıyor. Önce arama sonlandırılacak...");

                // 3. Navigasyonu geçici olarak DURDUR
                context.PreventNavigation();
                
                // 4. SignalR bağlantısı canlıyken aramayı GÜVENLE sonlandır
                await EndCall(); // Bu metot SignalR ile karşı tarafa haber verir

                // 5. Arama bittikten sonra, durdurduğumuz navigasyona MANUEL olarak devam et
                NavigationManager.NavigateTo(context.TargetLocation);
            }
        }
        
        // Video görüşmesi aktif değilse, hiçbir şey yapma ve navigasyona izin ver.
    }
    protected override async Task OnParametersSetAsync()
    {
        // Eğer aynı kullanıcıdaysak (sadece UI refresh olduysa) işlem yapma
        if (oldUserId == UserId) return;

        // 1. Eski verileri temizle
        oldUserId = UserId;
        ClearMessagesSafely(); 

        // 2. Yeni kullanıcı verilerini yükle
        await LoadInfo(); 
    
        // 3. Mesajları cache'den getir
        var loadedMessages = await _cacheService.LoadUserMessagesAsync(myId, UserId);
        SetMessagesSafely(loadedMessages);

        // 4. UI'ı güncelle ve aşağı kaydır
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300); // DOM'un mesajları çizmesi için kısa bir bekleme
        await ScrollToBottom();
    }

    // ✅✅✅ DEĞİŞİKLİK BURADA YAPILDI ✅✅✅
    private async Task LoadInfo()
    {
        userInfo = await _userService.GetUserInfo(UserId);
        
        // ❌ ESKİ YAVAŞ SATIR:
        // profileImageUrl = await imageService.GetImageThumbnailUrlAsync(UserId);
        
        // ✅ YENİ HIZLI SATIR (ÖNBELLEKTEN OKUMA):
        if (LayoutData != null && LayoutData.ProfileImages.TryGetValue(UserId, out var cachedUrl))
        {
            profileImageUrl = cachedUrl;
        }
        else
        {
            // Önbellekte bulamazsa (yedek plan), DB'den çek ve önbelleğe ekle
            profileImageUrl = await imageService.GetImageThumbnailUrlAsync(UserId);
            if (LayoutData != null)
            {
                LayoutData.ProfileImages[UserId] = profileImageUrl;
            }
        }
        
        // (Metodun kalanı aynı)
        myInfo = await _userService.GetCurrentUserAsync();
        if (myInfo == null)
        {
            Console.WriteLine("⚠️ Current user info null geldi, yükleme atlandı.");
            return;
        }
        myId = myInfo.Id;
    }
}