@page "/createGroup"
@using Domain.Entities
@using Domain.Enums
@using Domain.Interfaces
@using Domain.Models.Download
@using Infrastructure.Services.Events
@using Shared.Wrappers
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using Shared.Services
@inject IJSRuntime JSRuntime
@inject IImageService _imageService
@inject IGroupService _groupService
@inject NotificationService NotificationService
@inject GroupStateService GroupState
@inject EventShop EventShop
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="create-group-page">
    <RadzenCard class="create-group-compact">

        <!-- Header -->
        <div class="cg-header">
            <span>Grup oluştur</span>

            <RadzenButton Icon="close"
                          Variant="Variant.Text"
                          Size="ButtonSize.Small"
                          Click="@OnBack" />
        </div>

        <!-- Content -->
        <div class="cg-content">

            <!-- Avatar (TEK BAŞINA YUKARIDA) -->
            <div class="cg-avatar">
                <div class="cg-avatar-click" @onclick="TriggerFileInput">
                    @if (IsUploading)
                    {
                        <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small"
                                                   Mode="ProgressBarMode.Indeterminate" />
                    }
                    else if (!string.IsNullOrEmpty(GroupImageUrl))
                    {
                        <img src="@GroupImageUrl" />
                    }
                    else
                    {
                        <RadzenIcon Icon="group" />
                    }
                </div>

                <InputFile id="fileInput"
                           OnChange="HandleFileSelected"
                           accept="image/*"
                           style="display:none" />
            </div>


            <!-- INPUTLAR ALT ALTA -->
            <div class="cg-fields">
                <RadzenTextBox @bind-Value="GroupName"
                               Placeholder="Grup adı"
                               MaxLength="50"
                               class="cg-input" />

                <RadzenTextArea @bind-Value="GroupDescription"
                                Placeholder="Açıklama (isteğe bağlı)"
                                Rows="3"
                                MaxLength="200"
                                class="cg-input" />

                @if (ShowValidation && string.IsNullOrWhiteSpace(GroupName))
                {
                    <span class="cg-error">Grup adı gerekli</span>
                }
            </div>

        </div>

        <!-- Footer -->
        <div class="cg-footer">
            <RadzenButton Text="İptal"
                          Variant="Variant.Text"
                          Size="ButtonSize.Small"
                          Click="@OnBack" />

            <RadzenButton Text="Oluştur"
                          Size="ButtonSize.Small"
                          Disabled="@string.IsNullOrWhiteSpace(GroupName)"
                          Click="@Create"
                          class="cg-primary" />
        </div>

    </RadzenCard>
</div>

@code {

    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private InputFile fileInput;

    // Form Data
    private Guid GroupId = Guid.NewGuid();
    private string GroupName = string.Empty;
    private string? GroupDescription = string.Empty;
    private string? GroupImageUrl = string.Empty;
    private ChatRoomType GroupType = ChatRoomType.Group;


    // UI States
    private bool IsCreating = false;
    private bool IsUploading = false;
    private bool ShowValidation = false;

    [Parameter] public HashSet<Guid> SelectedUserIds { get; set; } = new(); // PARAMETRE

    protected override void OnInitialized()
    {
        SelectedUserIds = new HashSet<Guid>(GroupState.SelectedUserIds);
    }

    
    private async Task TriggerFileInput()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;

        try
        {
            IsUploading = true;
            await InvokeAsync(StateHasChanged);

            // Dosya kontrolleri
            if (e.File.Size > 10 * 1024 * 1024)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Dosya boyutu 10MB'dan küçük olmalıdır");
                return;
            }

            var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif" };
            if (!allowedTypes.Contains(e.File.ContentType.ToLower()))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = $"Sadece JPG, PNG ve GIF formatları desteklenmektedir",
                    Duration = 4000
                });
                return;
            }

            // FileInput oluştur
            var fileInput = new FileInput
            {
                FileName = e.File.Name,
                ContentType = e.File.ContentType,
                Size = e.File.Size,
                OpenStream = (maxSize) =>
                {
                    if (e.File.Size > maxSize)
                    {
                        throw new InvalidOperationException($"Dosya boyutu {e.File.Size} bytes, maximum {maxSize} bytes'ı aşıyor.");
                    }
                    return e.File.OpenReadStream(maxSize);
                }
            };

            // Service'i çağır
            var result = await _imageService.UploadImageAsync(GroupId, fileInput);

            if (result.IsSuccess)
            {
                GroupImageUrl = result.IsSuccess ? result.OriginalImageUrl : string.Empty;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = $"Grup fotoğrafı başarıyla yüklendi!",
                    Duration = 4000
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = $"Grup fotoğrafı yüklenemedi: {result.ErrorMessage}",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload hatası: {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Bir hata oluştu:{ex.Message}",
                Duration = 4000
            });

        }
        finally
        {
            IsUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RemoveImage()
    {
        GroupImageUrl = string.Empty;
        InvokeAsync(StateHasChanged);
    }

private async Task Create()
{
    ShowValidation = true;

    if (string.IsNullOrWhiteSpace(GroupName))
    {
        await InvokeAsync(StateHasChanged);
        return;
    }

    IsCreating = true;
    await InvokeAsync(StateHasChanged);

    try
    {
        var currentUserId = LayoutData?.CurrentUserId;
        if (currentUserId == null)
        {
            NotificationService?.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Kullanıcı bilgisi alınamadı.",
                Duration = 4000
            });
            return;
        }

        var newGroup = new ChatRoom
        {
            Id = GroupId,
            Name = GroupName.Trim(),
            Description = string.IsNullOrWhiteSpace(GroupDescription) ? null : GroupDescription.Trim(),
            Type = GroupType,
            CreatedByUserId = currentUserId.Value,
            CreatedAt = DateTime.UtcNow,
            IsActive = true,
            ImageUrl = GroupImageUrl
        };

        var success = await _groupService.CreateGroup(newGroup);

        if (success)
        {
            await AddMember();
            await DoAdminCreator(newGroup);
            
            // ✅ Tüm üye ID'lerini topla (creator + seçilen üyeler)
            var allMemberIds = new List<Guid>(SelectedUserIds);
            if (!allMemberIds.Contains(currentUserId.Value))
            {
                allMemberIds.Add(currentUserId.Value);
            }

            // 🆕 Grup oluşturuldu - tüm üyelere bildir
            await JSRuntime.InvokeVoidAsync(
                "window.signalRManager.notifyGroupCreated",
                GroupId  // sadece GroupId
            );

            OnBack();
        }
        else
        {
            NotificationService?.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Grup oluşturulamadı",
                Duration = 4000
            });
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Grup oluşturma hatası: {ex.Message}");
        NotificationService?.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Grup oluşturma hatası oluştu.",
            Duration = 4000
        });
    }
    finally
    {
        IsCreating = false;
        await InvokeAsync(StateHasChanged);
        EventShop?.TriggerOnGroupInfoUpdated();
    }
}

    private async Task DoAdminCreator(ChatRoom newGroup){
        if (newGroup.CreatedByUserId == null)
            return;
        var result = await _groupService.UpdateMemberAdminStatus(newGroup.Id, newGroup.CreatedByUserId.Value, isAdmin:true);
        if (result)
        {
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task AddMember()
    {
        try
        {
           await _groupService.AddMembersToGroup(GroupId, SelectedUserIds.ToList());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Üye ekleme hatası: {ex.Message}");
        }
    }
    private async Task OnBack()
    {
        GroupState.Clear();
        await JSRuntime.InvokeVoidAsync("history.back"); // Browser back
        await OnCancel.InvokeAsync();
    }

    // Helper class
    public class GroupTypeOption
    {
        public string Text { get; set; } = string.Empty;
        public ChatRoomType Value { get; set; }
    }
}