<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Convo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <style>
        /* Layout için genel stiller */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }

        .video-background {
            position: fixed; /* fixed yaparak sayfalar arası geçişte kalıcı olur */
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            overflow: hidden;
        }

        .bg-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .content-wrapper {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <!-- ARKAPlan VİDEOSU - Her sayfada aynı kalacak -->
    <div class="video-background">
        <video autoplay muted loop playsinline class="bg-video" preload="auto">
            <source src="/videos/login-bgg.mp4" type="video/mp4" />
            <!-- Fallback arkaplan -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 100%; height: 100%;"></div>
        </video>
    </div>

    <!-- İÇERİK ALANI -->
    <div class="content-wrapper">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>