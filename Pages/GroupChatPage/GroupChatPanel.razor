@page "/groupChat/{groupId:guid}"
@using System.Diagnostics.CodeAnalysis
@using Domain.Entities
@using Domain.Interfaces
@using Domain.Interfaces.ConferenceInterfaces
@using Domain.Constants
@using Domain.Enums
@using Convo.Shared.Models.Dtos
@using Convo.Shared.Wrappers
@using System.Text.Json
@using Domain.FileDataType;
@using Domain.Models.Download;
@using Radzen
@using Infrastructure.Services.Events
@inject IImageService imageService
@inject IUserService _userService
@inject IMessageService _messageService
@inject IJSRuntime JSRuntime
@inject ICacheService _cacheService
@inject IDownloadService _downloadService
@inject IConferenceService _conferenceService
@inject IGroupService _groupService
@inject HttpClient Http
@inject NotificationService NotificationService
@inject EventShop EventShop
@inject NavigationManager NavigationManager
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject IHttpContextAccessor HttpContextAccessor


@attribute [Authorize]

@if (groupInfo != null && groupInfo.Id != Guid.Empty)
{
<section id="chat-panel-section" class="chat @(isInVideoCall ? "video-call-mode" : "")">
    <!-- Header her zaman aynı -->
    <span @onclick="OpenGroupInfo" style="display: block; cursor: pointer;">
        <div class="header-chat">
            <div class="icon" style="@GetProfileImageStyle(groupInfo?.ImageUrl)">
                @if (string.IsNullOrEmpty(groupInfo?.ImageUrl))
                {
                    <span>G</span>
                }
            </div>
            <div class="group-info">
                <p class="name">@(groupInfo?.Name ?? "Yükleniyor...")</p>
                <p class="member-status">@GetActiveMemberStatus()</p>
            </div>
            @if (!showWaitingCall && !isInVideoCall)
            {
                if (roomId == 0)
                {
                    <div class="call-buttons" 
                         @onclick="StartVideoCall" 
                         @onclick:stopPropagation="true">
                        <i class="bi bi-camera-video-fill clickable"></i>
                    </div>
                }

                else
                {
                    <div class="call-buttons" 
                         @onclick="() => JoinConference(roomId)" 
                         @onclick:stopPropagation="true">
                        <div class="calling-ring">
                            <i class="bi bi-phone-vibrate-fill clickable calling-icon"></i>
                        </div>
                    </div>
                }
                @* @if(!isInVideoCall && roomId!=null){ *@
                @*     <i class="bi bi-telephone-outbound" *@
                @*        @onclick:stopPropagation="true" *@
                @*        @onclick="async () => await JoinConference(roomId)" ></i> *@
                @* } *@
            }
            else
            {
                <span><i class ="bi bi-telephone-fill clickable" ></i > Waiting...</span>
            }
        </div>
    </span>
    @if (isInVideoCall)
    {
        <!-- Video Call Layout -->
        <div class="video-call-content">
            <!-- Sol taraf - Video -->
            <div class="video-section">
                <div id="background-video"></div>
                <div id="small-videos"></div>

                <div class="video-controls">
                    <button class="btn-mic @(isMicMuted ? "muted" : "")" @onclick="ToggleMic">
                        <i class="bi @(isMicMuted ? "bi-mic-mute" : "bi-mic")"></i>
                    </button>
                    <button class="btn-camera @(isCameraOff ? "off" : "")" @onclick="ToggleCamera">
                        <i class="bi @(isCameraOff ? "bi-camera-video-off" : "bi-camera-video")"></i>
                    </button>
                    <button class="btn-end" @onclick="LeaveConference">
                        <i class="bi bi-telephone-x"></i>
                    </button>
                </div>
            </div>

            <!-- Sağ taraf - Chat -->
            <div class="chat-section">
                <div class="messages-chat" id="videoMessagesContainer">
                    @if (_messages != null && _messages.Any())
                    {
                        @foreach (var message in _messages)
                        {
                            @if (message.SenderId == myId)
                            {
                                <!-- Kendi mesajlarımız (sağ taraf) -->
                                <div class="message text-only">
                                    @if (message.Type == MessageType.Text)
                                    {
                                        <TextMessageComponent message="@message"MessageFrom="sent"/>
                                    }
                                    else if (message.Type==MessageType.Video)
                                    {
                                        <VideoMessageComponent message="@message" MessageFrom="sent" />
                                    }
                                    else
                                    {
                                        <!-- Dosya mesajı -->
                                        <FileMessageComponent message="@message" MessageFrom="sent"/>
                                            
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Karşı tarafın mesajları (sol taraf) -->
                                <div class="message">
                                    @{
                                        var sender = GetMessageSender(message.SenderId);
                                        var senderImageUrl = GetSenderProfileImage(message.SenderId);
                                    }

                                    <div class="photo" style="@GetProfileImageStyle(senderImageUrl)">
                                        @if (LayoutData?.OnlineUsers?.Contains(message.SenderId.ToString()) == true)
                                        {
                                            <div class="online"></div>
                                        }
                                    </div>

                                    @if (message.Type == MessageType.Text)
                                    {
                                        <TextMessageComponent message="@message" MessageFrom="received"/>
                                    }
                                    else if (message.Type==MessageType.Video)
                                    {
                                        <VideoMessageComponent message="@message" MessageFrom="received" />
                                    }
                                    else
                                    {
                                        <!-- Dosya mesajı -->
                                        <FileMessageComponent message="@message" MessageFrom="received"/>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="no-messages">
                            <p>Henüz mesaj yok</p>
                        </div>
                    }
                </div>

                <!-- Dosya önizlemesi - Video Call için -->
                @if (selectedFile != null)
                {
                    <div class="file-preview video-mode">
                        <!-- Dosya bilgisi -->
                        <div class="file-header">
                            <i class="@_downloadService.GetFileIcon(selectedFile.Name) file-icon"></i>
                            <div class="file-info">
                                <div class="file-name">@selectedFile.Name</div>
                                <div class="file-details">
                                    @_downloadService.GetFileSize(selectedFile.Size) • @_downloadService.GetFileExtension(selectedFile.Name)
                                </div>
                            </div>
                        </div>

                        @if (!isUploading)
                        {
                            <!-- Normal durumda gösterilen butonlar -->
                            <div class="preview-actions">
                                <button class="btn-send" @onclick="SendSelectedFile">
                                    <i class="bi bi-send"></i> Gönder
                                </button>
                                <button class="btn-cancel" @onclick="CancelFileSelection">
                                    <i class="bi bi-x"></i> İptal
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- Upload devam ederken gösterilen progress alanı -->
                            <div class="upload-progress-section">
                                <!-- Progress Bar -->
                                <div class="progress-container">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @(uploadProgress)%"></div>
                                    </div>
                                    <div class="progress-text">
                                        @uploadProgress.ToString("F1")% - @uploadStatus
                                    </div>
                                </div>

                                <!-- Speed & Time Info -->
                                <div class="upload-stats">
                                    <span>Hız: @uploadSpeed</span>
                                    <span>Kalan: @remainingTime</span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="upload-actions">
                                    @if (!_downloadService.IsPaused)
                                    {
                                        <button class="btn-warning" @onclick="_downloadService.PauseUpload">
                                            ⏸️ Duraklat
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-success" @onclick="_downloadService.ResumeUpload">
                                            ▶️ Devam
                                        </button>
                                    }

                                    <button class="btn-danger" @onclick="CancelUpload">
                                        ❌ İptal
                                    </button>

                                    @if (hasUploadError)
                                    {
                                        <button class="btn-info" @onclick="RetryUpload">
                                            🔄 Tekrar
                                        </button>
                                    }
                                </div>

                                <!-- Error Message -->
                                @if (hasUploadError)
                                {
                                    <div class="error-message">
                                        <strong>Hata:</strong> @uploadErrorMessage
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="footer-chat">
                    <!-- Chat input alanı -->
                    @* <div class="footer-left-icons"> *@
                    @*     <i class="bi bi-emoji-smile clickable" aria-hidden="true"></i> *@
                    @* </div> *@
                    <input type="text"
                           class="write-message"
                           placeholder="Mesajınızı yazın..."
                           @bind="newMessage"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyPress" />

                    <div class="footer-right-icons">
                        <InputFile id="fileInputVideo" OnChange="HandleFileSelected" style="display: none;" accept="*/*" />
                        <label for="fileInputVideo">
                            <i class="bi bi-file-earmark-post clickable"></i>
                        </label>
                        <i class="bi bi-send clickable" @onclick="SendTextMessage" aria-label="Send Message"></i>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Normal Chat Layout - DÜZELTİLMİŞ -->
        <div class="messages-chat" id="messagesContainer">
            @if (_messages != null && _messages.Any())
            {
                @foreach (var message in _messages)
                {
                    @if (message.SenderId == myId)
                    {
                        <!-- Kendi mesajlarımız (sağ taraf) -->
                        <div class="message text-only">
                            @if (message.Type == MessageType.Text)
                            {
                                <TextMessageComponent message="@message"MessageFrom="sent" />
                            }
                            else if (message.Type==MessageType.Video)
                            {
                                <VideoMessageComponent message="@message" MessageFrom="sent" />
                            }
                            else
                            {
                                <!-- Dosya mesajı -->
                                <FileMessageComponent message="@message" MessageFrom="sent"/>
                                   
                            }
                        </div>
                    }
                    else
                    {
                        <!-- ✅ DÜZELTİLDİ: Karşı tarafın mesajları (sol taraf) -->
                        <div class="message">
                            @{
                                var sender = GetMessageSender(message.SenderId);
                                var senderImageUrl = GetSenderProfileImage(message.SenderId);
                            }

                            <div class="photo" style="@GetProfileImageStyle(senderImageUrl)">
                                @if (LayoutData?.OnlineUsers?.Contains(message.SenderId.ToString()) == true)
                                {
                                    <div class="online"></div>
                                }
                            </div>

                            @if (message.Type == MessageType.Text)
                            {
                                <TextMessageComponent message="@message" MessageFrom="received" />
                                
                            }
                            else if (message.Type==MessageType.Video)
                            {
                                <VideoMessageComponent message="@message" MessageFrom="received" />
                            }
                            else
                            {
                                <!-- Dosya mesajı -->
                                <FileMessageComponent message="@message" MessageFrom="received" />
                                 
                            }
                        </div>
                    }
                }
            }
            else
            {
                <div class="no-messages">
                    <p>Henüz mesaj yok</p>
                </div>
            }
        </div>

        <!-- Dosya önizlemesi - Normal Chat için (mesajlar ile input arasında) -->
        @if (selectedFile != null)
        {
            <div class="file-preview normal-mode">
                <!-- Dosya bilgisi -->
                <div class="file-header">
                    <i class="@_downloadService.GetFileIcon(selectedFile.Name) file-icon"></i>
                    <div class="file-info">
                        <div class="file-name">@selectedFile.Name</div>
                        <div class="file-details">
                            @_downloadService.GetFileSize(selectedFile.Size) • @_downloadService.GetFileExtension(selectedFile.Name)
                        </div>
                    </div>
                </div>

                @if (!isUploading)
                {
                    <!-- Normal durumda gösterilen butonlar -->
                    <div class="preview-actions">
                        <button class="btn-send" @onclick="SendSelectedFile">
                            <i class="bi bi-send"></i> Gönder
                        </button>
                        <button class="btn-cancel" @onclick="CancelFileSelection">
                            <i class="bi bi-x"></i> İptal
                        </button>
                    </div>
                }
                else
                {
                    <!-- Upload devam ederken gösterilen progress alanı -->
                    <div class="upload-progress-section">
                        <!-- Progress Bar -->
                        <div class="progress-container">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(uploadProgress)%"></div>
                            </div>
                            <div class="progress-text">
                                @uploadProgress.ToString("F1")% - @uploadStatus
                            </div>
                        </div>

                        <!-- Speed & Time Info -->
                        <div class="upload-stats">
                            <span>Hız: @uploadSpeed</span>
                            <span>Kalan: @remainingTime</span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="upload-actions">
                            @if (!_downloadService.IsPaused)
                            {
                                <button class="btn-warning" @onclick="_downloadService.PauseUpload">
                                    ⏸️ Duraklat
                                </button>
                            }
                            else
                            {
                                <button class="btn-success" @onclick="_downloadService.ResumeUpload">
                                    ▶️ Devam
                                </button>
                            }

                            <button class="btn-danger" @onclick="CancelUpload">
                                ❌ İptal
                            </button>

                            @if (hasUploadError)
                            {
                                <button class="btn-info" @onclick="RetryUpload">
                                    🔄 Tekrar
                                </button>
                            }
                        </div>

                        <!-- Error Message -->
                        @if (hasUploadError)
                        {
                            <div class="error-message">
                                <strong>Hata:</strong> @uploadErrorMessage
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Normal footer-chat -->
        <div class="footer-chat">
            <!-- Chat input alanı -->
            @* <div class="footer-left-icons"> *@
            @*     <i class="bi bi-emoji-smile clickable" aria-hidden="true"></i> *@
            @* </div> *@
            <input type="text"
                   class="write-message"
                   placeholder="Mesajınızı yazın..."
                   @bind="newMessage"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyPress" />

            <div class="footer-right-icons">
                <InputFile id="fileInput" OnChange="HandleFileSelected" style="display: none;" accept="*/*" />
                <label for="fileInput">
                    <i class="bi bi-file-earmark-post clickable"></i>
                </label>

                <i class="bi bi-send clickable" @onclick="SendTextMessage" aria-label="Send Message"></i>
            </div>
        </div>
