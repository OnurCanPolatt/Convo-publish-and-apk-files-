</section>
}
else
{
    <div class="loading-panel rz-p-12 rz-text-align-center">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
        <p class="rz-mt-4">Grup bilgileri alınıyor veya grup artık mevcut değil...</p>
    </div>
}
@code {

    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }

    [Parameter] public Guid GroupId { get; set; }
    private Guid oldGroupId;

    private bool shouldAutoJoinConference = false;
    private int conferenceRoomId = 0;

    private ChatRoom groupInfo { get; set; } = new();
    private List<ChatRoomMember> groupMembers { get; set; } = new();
    private Guid myId { get; set; }
    private AppUser myInfo { get; set; }

    private string newMessage = "";
    private List<Message> _messages = new();
    private IBrowserFile selectedFile;

    // Upload UI Properties
    private bool isUploading = false;
    private bool hasUploadError = false;
    private double uploadProgress = 0;
    private string uploadStatus = "";
    private string uploadErrorMessage = "";
    private string uploadSpeed = "0 KB/s";
    private string remainingTime = "--:--";

    // Video Call Properties
    private bool isInVideoCall = false;
    private bool isMicMuted = false;
    private bool isCameraOff = false;
    private int roomId;
    private string statusMessage = string.Empty;
    private bool showWaitingCall = false;

    private readonly object _messagesLock = new object();
    private bool _jsInitialized = false;
    private bool _isSending = false;
    private bool _messagesLoaded = false; // ✅ Duplicate yükleme önleme flag
    private Dictionary<Guid, string> memberProfileImages = new();

    private bool _showGroupInfo = false;

    public bool showGroupInfo
    {
        get => _showGroupInfo;
        set
        {
            Console.WriteLine($"showGroupInfo değiştiriliyor: {_showGroupInfo} -> {value}");
            Console.WriteLine($"Stack Trace: {Environment.StackTrace}");
            _showGroupInfo = value;
        }
    }

    public List<Message> Messages
    {
        get
        {
            lock (_messagesLock)
            {
                return _messages.ToList(); // Safe copy
            }
        }
    }

    private void AddMessageSafely(Message message)
    {
        lock (_messagesLock)
        {
            // 1. Duplicate kontrolü
            if (_messages.Any(m => m.Id == message.Id))
            {
                Console.WriteLine($"⚠️ Duplicate mesaj eklenmedi: {message.Id}");
                return;
            }

            // 2. Mesajı ekle
            _messages.Add(message);

            // 3. ✅ CRITICAL: Tarih bazlı sıralama
            _messages = _messages
                .OrderBy(m => m.SentAt)
                .ThenBy(m => m.Id) // Aynı saniyede gelen mesajlar için ikincil sıralama
                .ToList();
        
            Console.WriteLine($"✅ Mesaj eklendi ve sıralandı. Toplam: {_messages.Count}, Son mesaj: {message.SentAt:o}");
        }
    }
    private void SetMessagesSafely(List<Message> newMessages)
    {
        lock (_messagesLock)
        {
            _messages.Clear();
            _messages.AddRange(newMessages ?? new List<Message>());
            Console.WriteLine($"✅ Messages set safely. Total: {_messages.Count}");
        }
    }

    private void ClearMessagesSafely()
    {
        lock (_messagesLock)
        {
            _messages.Clear();
            Console.WriteLine("✅ Messages cleared safely");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SubscribeToEvents();

        // ✅ URL query parametrelerini kontrol et
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("autoJoinConference", out var autoJoin) && autoJoin == "true")
        {
            shouldAutoJoinConference = true;

            if (query.TryGetValue("roomId", out var roomIdStr) && int.TryParse(roomIdStr, out var roomId))
            {
                conferenceRoomId = roomId;
                Console.WriteLine($"🎥 Otomatik katılım parametreleri alındı - RoomId: {conferenceRoomId}");
            }

        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
            
            if (!_jsInitialized)
            {
                _jsInitialized = true;
                try
                {
                    // ✅ DÜZELTME: Environment'a göre Janus endpoint seç
                    var isLocal = HttpContextAccessor.HttpContext?.Request.Host.Host == "localhost" ||
                                  HttpContextAccessor.HttpContext?.Request.Host.Host == "127.0.0.1";
        
                    var janusUrl = isLocal 
                        ? Configuration["Janus:HttpEndpoint"]
                        : Configuration["Janus:ExternalHttpEndpoint"];
                    await JSRuntime.InvokeVoidAsync("initJanus", janusUrl);
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Janus başlatılamadı");
                    statusMessage = "Janus başlatılırken bir hata oluştu";
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = statusMessage,
                        Duration = 4000
                    });
                }
            }
            var pendingRoomId = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "pendingConferenceRoomId");
        
            if (!string.IsNullOrEmpty(pendingRoomId) && int.TryParse(pendingRoomId, out var roomId))
            {
                // ✅ Temizle
                await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "pendingConferenceRoomId");
                await JoinConference(roomId);
            
                Console.WriteLine($"✅ Otomatik katılım tamamlandı - RoomId: {roomId}");
            }
        }
    }
    [SuppressMessage("ReSharper.DPA", "DPA0006: Large number of DB commands", MessageId = "count: 142")]
    protected override async Task OnParametersSetAsync()
    {
        // 🛡️ Eğer zaten bu gruptaysak (sadece UI yenilendiyse) işlem yapma
        if (oldGroupId == GroupId && _messagesLoaded)
        { 
            await ScrollToBottom();
            return;
        }

        Console.WriteLine($"🔄 Grup Değişimi Algılandı: {oldGroupId} -> {GroupId}");

        // 1️⃣ STATE SIFIRLAMA
        // Kritik: CleanupPreviousGroup yerine sadece mesajları temizliyoruz.
        // Çünkü EventShop aboneliklerini silersek yeni grupta mesaj alamayız.
        ClearMessagesSafely();
        oldGroupId = GroupId;
        _messagesLoaded = false; 
        

        // 2️⃣ YENİ GRUP VERİLERİNİ YÜKLE
        await LoadGroupData();

        // 3️⃣ SIGNALR HUB'A YENİ GRUP İÇİN KAYDOL
        // JS'e eklediğin yeni joinGroup metodunu burada çağırıyoruz
        if (LayoutData?.IsSignalRReady == true && _jsInitialized)
        {
            try 
            {
                // JS tarafındaki joinGroup artık tekil string bekliyor
                await JSRuntime.InvokeVoidAsync("window.signalRManager.joinGroup", GroupId.ToString());
                Console.WriteLine($"📡 SignalR: {GroupId} odasına web üzerinden katılım sağlandı.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"⚠️ SignalR Join hatası: {ex.Message}");
            }
        }
    }
    private async Task LoadGroupData()
    {
        groupInfo = await _groupService.GetFreshGroupInfo(GroupId);
        if(groupInfo == null) return;

        groupMembers = groupInfo?.Members?.ToList() ?? new List<ChatRoomMember>();

        myInfo = await _userService.GetCurrentUserAsync();
        if (myInfo == null)
        {
            Console.WriteLine("❌ Current user info could not be loaded!");
            return;
        }
        myId = myInfo.Id;

        await LoadMemberProfileImages();

        // Sadece ilk yüklemede veya grup değiştiğinde cache'den oku
        if (!_messagesLoaded)
        {
            var loadedMessages = await _cacheService.LoadGroupMessagesAsync(GroupId);
            SetMessagesSafely(loadedMessages);
            _messagesLoaded = true;
        }

        // ✅ ADIM 4.1: AKTİF ODAYI SUNUCUDAN KONTROL ET
        // Component'in yerel 'roomId' değişkenini doldurur.
        try
        {
            if (LayoutData?.IsSignalRReady == true) // Önceki adımdan (gruplara katılma)
            {
                this.roomId = await JSRuntime.InvokeAsync<int>("window.signalRManager.getActiveRoomForGroup", GroupId);
            
                if (this.roomId != 0)
                {
                    Console.WriteLine($"✅ Sunucudan aktif oda durumu alındı: {this.roomId}");
                }
            }
            else
            {
                Console.WriteLine("⚠️ SignalR hazır değil, oda durumu kontrol edilemedi. (Sayfa yenilemesi gerekebilir)");
                this.roomId = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Aktif oda kontrol hatası: {ex.Message}");
            this.roomId = 0;
        }

        // ✅ DÜZELTME: DOM'un render olmasını bekle (Aynı kalır)
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        await ScrollToBottom();
    }

    private async Task LoadMemberProfileImages()
    {
        if (groupMembers == null || !groupMembers.Any() || LayoutData == null)
        {
            memberProfileImages = new Dictionary<Guid, string>();
            return;
        }

        Console.WriteLine($"🖼️ {groupMembers.Count} üyenin fotoğrafı önbellekten yükleniyor...");

        // 1. Gruptaki tüm üyelerin ID'lerini bir listeye topla
        var memberIds = groupMembers.Select(m => m.UserId).ToList();

        // 2. 'MainLayout' önbelleğinden ('LayoutData.ProfileImages') bu ID'lere ait fotoğrafları al.
        //    Eğer önbellekte yoksa (ki olmamalı), 'ImageService' ile DB'den çek (yedek plan).
        var tempImages = new Dictionary<Guid, string>();
        foreach (var memberId in memberIds)
        {
            if (LayoutData.ProfileImages.TryGetValue(memberId, out var cachedUrl))
            {
                // HIZLI YOL: Önbellekte bulundu
                tempImages[memberId] = cachedUrl;
            }
            else
            {
                // YAVAŞ YOL (Yedek Plan): Önbellekte yok, DB/MinIO'dan çek ve önbelleğe ekle
                try
                {
                    var dbUrl = await imageService.GetImageThumbnailUrlAsync(memberId);
                    tempImages[memberId] = dbUrl;
                    LayoutData.ProfileImages[memberId] = dbUrl; // Gelecek için önbelleğe ekle
                }
                catch
                {
                    tempImages[memberId] = "/images/default-avatar.png";
                }
            }
        }

        // 3. Component'in kullandığı 'memberProfileImages' sözlüğünü doldur
        memberProfileImages = tempImages;
        
        Console.WriteLine($"✅ {memberProfileImages.Count} üye fotoğrafı yüklendi.");
    }

    private string GetActiveMemberStatus()
    {
        if (groupMembers == null || !groupMembers.Any())
            return "Üye bilgisi yükleniyor...";

        var activeMembers = groupMembers.Count(m => m.IsActive);
        var onlineMembers = groupMembers.Count(m =>
            m.IsActive && LayoutData?.OnlineUsers?.Contains(m.UserId.ToString()) == true);

        return $"{activeMembers} üye • {onlineMembers} aktif";
    }

    private void OpenGroupInfo()
    {
        Console.WriteLine($"🔵 OpenGroupInfo - Navigate to /groupInfo/{GroupId}");
        NavigationManager.NavigateTo($"/groupInfo/{GroupId}");
    }

    private void SubscribeToEvents()
    {
        EventShop.OnReceiveMessage -= HandleReceiveGroupMessage;
        EventShop.OnFriendJoinedConference -= HandleFriendJoined;
        EventShop.OnGroupInfoUpdated -= HandleUpdateGroupInfo;
        EventShop.OnGroupConferenceEnded -= HandleGroupConferenceEndedAsync;
        
        EventShop.OnReceiveMessage += HandleReceiveGroupMessage;
        EventShop.OnFriendJoinedConference += HandleFriendJoined;
        EventShop.OnGroupInfoUpdated += HandleUpdateGroupInfo;
        EventShop.OnGroupConferenceEnded += HandleGroupConferenceEndedAsync;
        
        _downloadService.OnUploadProgressChanged -= OnUploadProgressChanged;
        _downloadService.OnUploadStatusChanged -= OnUploadStatusChanged;
        _downloadService.OnUploadError -= OnUploadError;
        _downloadService.OnUploadCompleted -= OnUploadCompleted;
        _downloadService.OnUploadCancelled -= OnUploadCancelled;
        
        _downloadService.OnUploadProgressChanged += OnUploadProgressChanged;
        _downloadService.OnUploadStatusChanged += OnUploadStatusChanged;
        _downloadService.OnUploadError += OnUploadError;
        _downloadService.OnUploadCompleted += OnUploadCompleted;
        _downloadService.OnUploadCancelled += OnUploadCancelled;

    }
    private void CleanupPreviousGroup()
    {
        if (isInVideoCall)
        {
            Task.Run(async () => await LeaveConference());
        }
        ClearMessagesSafely();
        _messagesLoaded = false;
    }
    public void Dispose()
    {
        EventShop.OnReceiveMessage -= HandleReceiveGroupMessage;
        EventShop.OnFriendJoinedConference -= HandleFriendJoined;
        EventShop.OnGroupInfoUpdated -= HandleUpdateGroupInfo;
        EventShop.OnGroupConferenceEnded -= HandleGroupConferenceEndedAsync;

        // DownloadService event handlers
        _downloadService.OnUploadProgressChanged -= OnUploadProgressChanged;
        _downloadService.OnUploadStatusChanged -= OnUploadStatusChanged;
        _downloadService.OnUploadError -= OnUploadError;
        _downloadService.OnUploadCompleted -= OnUploadCompleted;
        _downloadService.OnUploadCancelled -= OnUploadCancelled;
        
        CleanupPreviousGroup();
    }

