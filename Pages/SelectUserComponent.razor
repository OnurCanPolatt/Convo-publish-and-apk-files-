@using Domain.Entities
@using Domain.Interfaces
@using Infrastructure.Services.Events
@inject IFriendService _friendService
@inject IUserService _userService
@inject IImageService imageService
@inject NavigationManager Navigation
@inject EventShop EventShop
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (isVisible)
{
    @if (friendsWithUsers != null && friendsWithUsers.Any())
    {
        @foreach (var item in GetFilteredFriends())
        {
            var friendUser = item.user;
            
            @* ✅ DEĞİŞİKLİK: Fotoğraf artık LayoutData'dan (cache) alınıyor *@
            var profileImageUrl = LayoutData?.ProfileImages.ContainsKey(friendUser.Id) == true
                ? LayoutData.ProfileImages[friendUser.Id]
                : "/images/default-avatar.png";

            <div class="discussion" @onclick="() => SelectUser(friendUser.Id)">
                @if (ShowCheckboxes)
                {
                    <input type="checkbox"
                           @onclick:stopPropagation="true"
                           @onchange="(e) => ToggleUserSelection(friendUser.Id, (bool)e.Value!)"
                           style="margin-right: 10px;" />
                }
                <div class="photo" style="@GetProfileImageStyle(profileImageUrl)">
                    @if (LayoutData?.OnlineUsers?.Contains(friendUser.Id.ToString()) == true)
                    {
                        <div class="online"></div>
                    }
                </div>
                <div class="desc-contact">
                    <p class="name">@friendUser.UserName</p>
                </div>
            </div>
        }
    }
    else if (isLoading)
    {
        <div class="no-data">
            <p>Arkadaşlar yükleniyor...</p>
        </div>
    }
    else
    {
        <div class="no-data">
            <p>Henüz arkadaşınız yok</p>
        </div>
    }
}

@code {
    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }

    [Parameter] public bool isVisible { get; set; }
    [Parameter] public string SearchTerm { get; set; } = "";
    [Parameter] public bool ShowCheckboxes { get; set; } = false;
    [Parameter] public EventCallback<int> OnSelectionChanged { get; set; }
    [Parameter] public HashSet<Guid> SelectedUserIds { get; set; } = new();
    [Parameter] public EventCallback<HashSet<Guid>> SelectedUserIdsChanged { get; set; }

    private List<Friend>? myFriends;
    private List<(Friend friend, AppUser user)> friendsWithUsers = new();
    
    // ❌ SİLİNDİ: private Dictionary<Guid, string> friendProfileImages = new();
    
    private string currentUserName = "";
    private Guid currentUserId;
    private bool isLoading = false;
    private bool _hasInitialized = false;
    private bool _disposed = false;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        if (isVisible && !_hasInitialized)
        {
            _hasInitialized = true;
            isLoading = true;
            await InvokeSafeUIUpdate();

            await InitializeData();

            isLoading = false;
            await InvokeSafeUIUpdate();

            EventShop.OnUIRefreshNeeded += HandleUIRefresh;
            EventShop.OnUserInfoUpdated += HandleUserInfoUpdated;  // ✅ YENİ: Eklendi
        }

        if (!isVisible)
        {
            _hasInitialized = false;
            EventShop.OnUIRefreshNeeded -= HandleUIRefresh;
            EventShop.OnUserInfoUpdated -= HandleUserInfoUpdated;  // ✅ YENİ: Eklendi
        }
    }

    // ❌ SİLİNDİ: HandleUserInfoUpdated metodu kaldırıldı.
    // Artık fotoğraflar Layout'tan geldiği için bu metoda gerek yok.

    private async Task InitializeData()
    {
        try
        {
            Console.WriteLine("📦 SelectUserComponent: Veri yükleniyor...");
            var currentUser = await _userService.GetCurrentUserAsync();
            if (currentUser == null) return;

            currentUserName = currentUser.UserName ?? "";
            currentUserId = currentUser.Id;

            await GetMyFriends();
            await LoadFriendsWithUsers(currentUserId);
            
            // ❌ SİLİNDİ: await LoadFriendProfileImages();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ InitializeData hatası: {ex.Message}");
        }
    }

    private async void HandleUIRefresh(object? sender, EventArgs e)
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(async () =>
            {
                Console.WriteLine("🔄 SelectUserComponent HandleUIRefresh çalıştı!");
                await GetMyFriends();
                await LoadFriendsWithUsers(currentUserId);
                
                // ❌ SİLİNDİ: await LoadFriendProfileImages();
                
                await InvokeSafeUIUpdate();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ HandleUIRefresh hatası: {ex.Message}");
        }
    }
    private async void HandleUserInfoUpdated(object? sender, EventArgs e)
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(async () =>
            {
                Console.WriteLine("🔄 SelectUserComponent: Profil fotoğrafı güncellendi, UI yenileniyor...");
                // LayoutData.ProfileImages zaten MainLayout tarafından güncellenmiş
                // Sadece UI'ı yeniden render et
                await InvokeSafeUIUpdate();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ HandleUserInfoUpdated hatası: {ex.Message}");
        }
    }


    private async Task GetMyFriends()
    {
        try
        {
            myFriends = await _friendService.GetMyFriends();
            Console.WriteLine($"✅ Arkadaş sayısı: {myFriends?.Count ?? 0}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Arkadaş getirme hatası: {ex.Message}");
            myFriends = new List<Friend>();
        }
    }

    private async Task LoadFriendsWithUsers(Guid currentUserId)
    {
        if (myFriends == null || !myFriends.Any()) return;

        try
        {
            var tasks = myFriends.Select(async friend =>
            {
                var friendUser = await GetFriendUserAsync(friend, currentUserId);
                return friendUser != null ? (friend, friendUser) : ((Friend, AppUser)?)null;
            }).ToList();

            var results = await Task.WhenAll(tasks);

            friendsWithUsers = results
                .Where(r => r.HasValue)
                .Select(r => r!.Value)
                .ToList();

            Console.WriteLine($"✅ Friend-User çiftleri yüklendi: {friendsWithUsers.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ LoadFriendsWithUsers hatası: {ex.Message}");
            friendsWithUsers = new();
        }
    }

    // ❌ SİLİNDİ: LoadFriendProfileImages() metodu tamamen kaldırıldı.
    
    private async Task<AppUser?> GetFriendUserAsync(Friend friend, Guid currentUserId)
    {
        try
        {
            if (friend == null) return null;

            // ✅ FIX: GetMyFriends artık sadece UserId=currentUserId döndürüyor
            // Bu yüzden her zaman FriendUser döndürmeliyiz
            return friend.FriendUser;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GetFriendUserAsync hatası: {ex.Message}");
            return null;
        }
    }

    private IEnumerable<(Friend friend, AppUser user)> GetFilteredFriends()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return friendsWithUsers;

        return friendsWithUsers.Where(item =>
            item.user.UserName?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) == true
        );
    }

    private string GetProfileImageStyle(string? imageUrl) // ✅ Artık null olabilir (string?)
    {
        if (string.IsNullOrEmpty(imageUrl) || imageUrl == "/images/default-avatar.png")
            return "background-color: #E6E7ED;";

        return $"background-image: url('{imageUrl}'); background-size: cover; background-position: center;";
    }

    private void SelectUser(Guid userId)
    {
        Navigation.NavigateTo($"/chatPanel/{userId}");
    }

    private async Task ToggleUserSelection(Guid userId, bool isSelected)
    {
        if (isSelected)
            SelectedUserIds.Add(userId);
        else
            SelectedUserIds.Remove(userId);

        SelectedUserIds.Add(LayoutData?.CurrentUserId ?? Guid.Empty);

        await SelectedUserIdsChanged.InvokeAsync(SelectedUserIds);
        await OnSelectionChanged.InvokeAsync(SelectedUserIds.Count - 1);
        await InvokeSafeUIUpdate();
    }

    private async Task InvokeSafeUIUpdate()
    {
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"UI güncellenemedi: {ex.Message}");
            }
        }
    }
    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        EventShop.OnUIRefreshNeeded -= HandleUIRefresh;
        EventShop.OnUserInfoUpdated -= HandleUserInfoUpdated;  // ✅ YENİ: Eklendi

        Console.WriteLine("🧹 SelectUserComponent temizlendi ve iptal edildi.");
    }

}