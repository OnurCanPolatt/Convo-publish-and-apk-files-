@page "/profile"
@using Microsoft.AspNetCore.Components.Forms
@using Domain.Entities
@using Domain.Interfaces
@using Domain.Models.Download
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using Infrastructure.Services.Events
@inject IJSRuntime JSRuntime
@inject IUserService UserService
@inject IImageService ImageService
@inject NavigationManager Navigation
@inject EventShop EventShop
@inject NotificationService NotificationService
@using Convo.Shared.Layout  
@using System.Text.RegularExpressions

<div class="profile-page-wrapper">
    <div class="profile-container">

        <!-- HEADER -->
        <div class="profile-custom-header">
            <div class="header-left">
                <RadzenIcon Icon="manage_accounts" class="header-icon" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">
                    <b>Profilimi Düzenle</b>
                </RadzenText>
            </div>

            <button class="header-close-btn" @onclick="OnClose">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- BODY -->
        <div class="profile-main-body">

            <!-- LEFT PANEL -->
            <div class="side-panel">
                <div class="photo-card">
                    <div class="avatar-wrapper-new">
                        @if (IsUploading)
                        {
                            <div class="upload-overlay-new">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                            </div>
                        }

                        @if (string.IsNullOrEmpty(ProfileImageUrl) || ProfileImageUrl == "/images/default-avatar.png")
                        {
                            @* Profil sayfasına özel büyük default ikon *@
                            <div class="main-profile-img-new default-profile-container">
                                <i class="bi bi-person-circle default-avatar-icon-profile"></i>
                            </div>
                        }
                        else
                        {
                            <RadzenImage Path="@ProfileImageUrl" class="main-profile-img-new" />
                        }

                      
                    </div>

                    <div class="user-meta rz-mt-4">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0"><b>@currentUser?.FirstName @currentUser?.LastName</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-info-dark">@@@currentUser?.UserName</RadzenText>
                    </div>

                    @* ✅ Fotoğraf Aksiyon Butonları *@
                    <div class="photo-actions-group rz-mt-4">
                        @* InputFile artık tamamen gizli ama butona (label üzerinden) bağlı *@
                        <InputFile id="fileInput" OnChange="HandleFileSelected" accept="image/*" style="display:none;" />
            
                        <label class="custom-file-upload" for="fileInput">
                            <i class="bi bi-image rz-mr-1"></i> Fotoğrafı Değiştir
                        </label>

                        @if (ProfileImageUrl != "/images/default-avatar.png")
                        {
                            <RadzenButton Text="Kaldır" 
                                          Icon="delete" 
                                          Click="DeleteProfileImage" 
                                          ButtonStyle="ButtonStyle.Danger" 
                                          Variant="Variant.Text" 
                                          Size="ButtonSize.ExtraSmall" />
                        }
                    </div>
                </div>
                <div class="stats-card">
                    <div class="stat-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        @(currentUser?.City ?? "Belirtilmemiş"), @(currentUser?.Country ?? "TR")
                    </div>
                    <div class="stat-item">
                        <i class="bi bi-calendar-event-fill"></i>
                        @currentUser?.Age Yaşında
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL -->
            <div class="form-panel">
                <div class="form-grid">

                    <div class="input-row-group">
                        <div class="form-group">
                            <label>Email</label>
                            <div class="input-with-action">
                                <RadzenTextBox @bind-Value="@tempEmail" />
                                <RadzenButton Icon="save"
                                              Click="@(() => UpdateEmail(tempEmail))"
                                              Disabled="@IsUpdatingEmail" />

                            </div>
                        </div>

                        <div class="form-group">
                            <label>Kullanıcı Adı</label>
                            <div class="input-with-action">
                                <RadzenTextBox @bind-Value="@tempUsername" />
                                <RadzenButton Icon="save"
                                              Click="@(() => UpdateUsername(tempUsername))"
                                              Disabled="@IsUpdatingUsername" />

                            </div>
                        </div>
                    </div>

                    <div class="input-row-group">
                        <div class="form-group">
                            <label>Telefon</label>
                            <div class="input-with-action">
                                <RadzenTextBox @bind-Value="@tempPhone" />
                                <RadzenButton Icon="save"
                                              Click="@(() => UpdateSingleField("phone", tempPhone))"
                                              Disabled="@IsUpdatingField["phone"]" />

                            </div>
                        </div>

                        <div class="form-group">
                            <label>Şehir / Ülke</label>
                            <div class="vertical-group">
                                <RadzenTextBox @bind-Value="@tempCity" Placeholder="Şehir" />
                                <RadzenButton Icon="check"
                                              Click="@(() => UpdateSingleField("city", tempCity))"
                                              Disabled="@IsUpdatingField["city"]" />
                                <div class="input-with-action">
                                    <RadzenTextBox @bind-Value="@tempCountry" Placeholder="Ülke" />
                                    <RadzenButton Icon="check"
                                                  Click="@(() => UpdateSingleField("country", tempCountry))"
                                                  Disabled="@IsUpdatingField["country"]" />

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Şifre Güvenliği</label>
                        <div class="input-with-action password-flex">
                            <RadzenPassword @bind-Value="currentPassword" Placeholder="Mevcut" />
                            <RadzenPassword @bind-Value="tempPassword" Placeholder="Yeni" />
                            <RadzenButton Text="GÜNCELLE"
                                          Icon="security"
                                          Click="@(() => UpdatePassword(currentPassword, tempPassword))"
                                          Disabled="@IsUpdatingPassword" />

                        </div>
                    </div>

                    <div class="form-group">
                        <label>Hakkımda</label>
                        <RadzenTextArea @bind-Value="@tempAbout" />
                        <RadzenButton Text="HAKKIMDA BİLGİSİNİ KAYDET"
                                      Icon="done_all"
                                      Click="@(() => UpdateSingleField("about", tempAbout ?? ""))"
                                      Disabled="@IsUpdatingField["about"]"
                                      class="rz-w-100 rz-mt-2" />

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }

    [Parameter] public EventCallback OnProfileUpdated { get; set; }

    // --- Tüm alanlar (fields) burada kalır ---
    private AppUser? currentUser;
    private string ProfileImageUrl = "/images/default-avatar.png";
    private bool IsUploading = false;

    private bool IsUpdatingEmail = false;
    private bool IsUpdatingUsername = false;
    private bool IsUpdatingPassword = false;

    private Dictionary<string, bool> IsUpdatingField = new()
    {
        {"phone", false},
        {"country", false},
        {"city", false},
        {"about", false}
    };

    private string tempEmail = string.Empty;
    private string tempUsername = string.Empty;
    private string currentPassword = string.Empty;
    private string tempPassword = string.Empty;
    private string tempPhone = string.Empty;
    private string tempCountry = string.Empty;
    private string tempCity = string.Empty;
    private string? tempAbout = string.Empty;

    
    // --- Diğer metotlar burada kalır ---

    private async Task OnClose()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadProfileImageFromCache();
        InitializeTempValues();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            currentUser = await UserService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kullanıcı yükleme hatası: {ex.Message}");
        }
    }
    
    private async Task LoadProfileImageFromCache()
    {
        if (currentUser?.Id == null || LayoutData == null)
        {
            ProfileImageUrl = "/images/default-avatar.png";
            return;
        }

        try
        {
            if (LayoutData.ProfileImages.TryGetValue(currentUser.Id, out var cachedUrl))
            {
                ProfileImageUrl = cachedUrl;
            }
            else
            {
                ProfileImageUrl = await ImageService.GetImageUrlAsync(currentUser.Id);
                LayoutData.ProfileImages[currentUser.Id] = ProfileImageUrl;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Profil fotoğrafı yükleme hatası: {ex.Message}");
            ProfileImageUrl = "/images/default-avatar.png";
        }
    }

    private void InitializeTempValues()
    {
        if (currentUser != null)
        {
            tempEmail = currentUser.Email ?? "";
            tempUsername = currentUser.UserName ?? "";
            tempPhone = currentUser.PhoneNumber ?? "";
            tempCountry = currentUser.Country;
            tempCity = currentUser.City;
            tempAbout = currentUser.About ?? "";
        }
    }

    // UpdateSingleField metodu burada kalır
    private async Task UpdateSingleField(string fieldName, string newValue)
    {
        try
        {
            // C# Tarafı Validasyon
            if (string.IsNullOrWhiteSpace(newValue))
            {
                 NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = $"{GetFieldDisplayName(fieldName)} alanı boş olamaz.",
                    Duration = 4000
                });
                return;
            }

            if (fieldName == "phone")
            {
                if (!Regex.IsMatch(newValue, @"^\d{11}$"))
                {
                     NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Warning,
                        Summary = "Telefon numarası 11 haneli ve sadece rakam olmalı.",
                        Duration = 4000
                    });
                    return;
                }
            }

            IsUpdatingField[fieldName] = true;
            await InvokeAsync(StateHasChanged);

            var success = await UserService.UpdateUserFieldAsync(fieldName, newValue);

            if (success)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = $"{GetFieldDisplayName(fieldName)} başarıyla güncellendi!",
                    Duration = 4000
                });
                await LoadCurrentUser();
                await OnProfileUpdated.InvokeAsync();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = $"{GetFieldDisplayName(fieldName)} güncellenirken bir hata oluştu.",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{fieldName} güncelleme hatası: {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary ="Bir hata oluştu. Lütfen tekrar deneyin.",
                Duration = 4000
            });
        }
        finally
        {
            IsUpdatingField[fieldName] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetFieldDisplayName(string fieldName)
    {
        return fieldName.ToLower() switch
        {
            "phone" => "Telefon",
            "country" => "Ülke",
            "city" => "Şehir",
            "about" => "Hakkımda",
            _ => fieldName
        };
    }
}