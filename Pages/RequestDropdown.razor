@page "/request"
@using Radzen
@using Radzen.Blazor
@using Domain.Interfaces
@using Domain.Entities
@using Domain.Enums
@using Infrastructure.Services.Events
@inject ICacheService CacheService
@inject IUserService _userService
@inject IFriendService _friendService
@inject EventShop EventShop
@implements IDisposable 
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="notification-dropdown">
    <!-- Header -->
    <div class="notification-header">
        <h5>İstekler</h5>
    </div>

    <!-- Content -->
    <div class="notification-content">
        @if (!allRequestNotifications.Any())
        {
            <!-- Boş durum -->
            <div class="notification-empty">
                <i class="bi bi-bell-slash"></i>
                <p>Henüz İstek yok</p>
            </div>
        }
        else
        {
            <!-- Okunmuş bildirimler -->
            @if (allRequestNotifications.Any())
            {
                <div class="notification-section">
                    <h6 class="section-title">All</h6>
                    @foreach (var request in allRequestNotifications.Take(50))
                    {
                        <div class="notification-item read">
                            <div class="notification-avatar">
                                @if (LayoutData != null && LayoutData.ProfileImages.TryGetValue(request.SenderId, out var imageUrl) 
                                                        && !string.IsNullOrEmpty(imageUrl))
                                {
                                    <img src="@imageUrl" class="user-avatar" alt="@request.Sender.UserName" />
                                }
                                else
                                {
                                    @* Standart Default Avatar - CSS'deki default-avatar-icon sınıfını kullanıyoruz *@
                                    <i class="bi bi-person-circle default-avatar-icon"></i>
                                }
                            </div>
                            <div class="notification-text">
                                <p>@request.Sender.UserName: @GetRequestMessage(request)</p>
                                <small>@GetTimeAgo(request.SentAt)</small>
                                <div class="request-actions">
                                    <button class="request-action-btn accept-btn" @onclick="() => AcceptRequest(request.SenderId)" title="Kabul Et">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="request-action-btn reject-btn" @onclick="() => RejectRequest(request.SenderId)" title="Reddet">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private List<Request> allRequestNotifications = new();
    private AppUser userInfo { get; set; }
    private Guid userId { get; set; }

    [CascadingParameter(Name = "LayoutData")]
    public Convo.Shared.Layout.MainLayout.LayoutDataModel? LayoutData { get; set; }
    
    private EventHandler? _uiRefreshHandler;
    private EventHandler? _receiveRequestHandler;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await _userService.GetCurrentUserAsync();
        if (userInfo == null)
        {
            Console.WriteLine("⚠️ Current user null - RequestComponent başlatılamadı.");
            return;
        }

        userId = userInfo.Id;
        _uiRefreshHandler = async (s, e) => await HandleUIRefresh(s, e);
        _receiveRequestHandler = async (s, e) => await RefreshCacheInternal();
        // Eventleri güvenli bağla
        EventShop.OnUIRefreshNeeded += _uiRefreshHandler;
        EventShop.OnReceiveRequests += _receiveRequestHandler;

        await RefreshCacheInternal();
        await OnClose.InvokeAsync(true);
    }

    private async Task HandleUIRefresh(object? sender, EventArgs e)
    {
        try
        {
            await RefreshCacheInternal();
            EventShop.TriggerRequestCountChanged(allRequestNotifications.Count);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ HandleUIRefresh hata: {ex.Message}");
        }
    }

    private async Task RefreshCacheInternal()
    {
        try
        {
            if (userId == Guid.Empty) return;

            Console.WriteLine("🔄 RequestDropdown RefreshCache çağrıldı");
            var freshRequests = await CacheService.GetUserRequests(userId) ?? new List<Request>();

            bool changed = !Enumerable.SequenceEqual(
                allRequestNotifications.Select(r => r.Id),
                freshRequests.Select(r => r.Id)
            );

            if (changed)
            {
                allRequestNotifications = freshRequests;
                Console.WriteLine($"📊 RequestDropdown güncellendi: {freshRequests.Count} istek");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ RefreshCacheInternal error: {ex.Message}");
        }
    }

    public async Task RefreshRequests()
    {
        // Fresh data al
        var freshRequests = await CacheService.GetUserRequests(userId);
        allRequestNotifications = freshRequests;

        // LayoutData'yı da güncelle
        if (LayoutData != null)
        {
            LayoutData.CurrentRequests = freshRequests;
        }

        await InvokeAsync(StateHasChanged);
        Console.WriteLine($"✅ RequestDropdown refreshed - {freshRequests.Count} requests");
    }

    // Console'a yazdır - debug için
    private string GetRequestIcon(RequestType type)
    {
        Console.WriteLine($"DEBUG - Type: {type}, Value: {(int)type}");

        return type switch
        {
            RequestType.FriendRequest => "person-plus-fill",
            RequestType.GroupInvite => "people-fill",
            _ => "bell" // default ikon
        };
    }

    private string GetRequestMessage(Request request)
    {
        return request.RequestType switch
        {
            RequestType.FriendRequest => "Arkadaşlık isteği yolladı",
            RequestType.GroupInvite => "Grup daveti yolladı",
            _ => "bell" // default ikon
        };
    }

    private string GetTimeAgo(DateTime createdAt)
    {
        var timeSpan = DateTime.UtcNow - createdAt;
        return timeSpan switch
        {
            { TotalMinutes: < 1 } => "Şimdi",
            { TotalMinutes: < 60 } => $"{(int)timeSpan.TotalMinutes} dk önce",
            { TotalHours: < 24 } => $"{(int)timeSpan.TotalHours} saat önce",
            { TotalDays: < 7 } => $"{(int)timeSpan.TotalDays} gün önce",
            _ => createdAt.ToString("dd.MM.yyyy")
        };
    }

    public async Task AcceptRequest(Guid senderId)
    {
        // Request'i bul
        var request = allRequestNotifications.FirstOrDefault(r => r.SenderId == senderId);
        if (request != null)
        {
            // Request'i listeden kaldır (UI güncelleme)
            allRequestNotifications.Remove(request);
            await CacheService.RemoveRequestFromCacheAsync(userId, request.Id);
            await _friendService.AcceptFriendRequest(senderId);

            // ✅ EventShop trigger - UserDiscovery'yi güncelle
            EventShop.TriggerFriendInfoSelfReceived();
            await Task.Delay(100);
            EventShop.TriggerUIRefreshNeeded();
            EventShop.TriggerRequestCountChanged(allRequestNotifications.Count);
            InvokeAsync(StateHasChanged);
        }
    }

    public async Task RejectRequest(Guid senderId)
    {
        var request = allRequestNotifications.FirstOrDefault(r => r.SenderId == senderId);
        if (request != null)
        {
            // Request'i listeden kaldır
            allRequestNotifications.Remove(request);
            await CacheService.RemoveRequestFromCacheAsync(userId, request.Id);
            await _friendService.RejectFriendRequest(senderId);

            // ✅ EventShop trigger - UserDiscovery'yi güncelle
            EventShop.TriggerFriendInfoSelfReceived();
            EventShop.TriggerRequestCountChanged(allRequestNotifications.Count);
            InvokeAsync(StateHasChanged);
        }
    }

    // ✅ Grup daveti kabul et
    private async Task AcceptGroupInvite(Guid notificationId)
    {
        try
        {
            Console.WriteLine($"✅ Grup daveti kabul edildi: {notificationId}");
            // TODO: Grup daveti kabul etme işlemi
            // await _groupService.AcceptGroupInviteAsync(notificationId);
            // Notification'ı okundu olarak işaretle ve kaldır
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Grup daveti kabul hatası: {ex.Message}");
        }
    }

    // ❌ Grup daveti reddet
    private async Task RejectGroupInvite(Guid notificationId)
    {
        try
        {
            Console.WriteLine($"❌ Grup daveti reddedildi: {notificationId}");
            // TODO: Grup daveti reddetme işlemi
            // await _groupService.RejectGroupInviteAsync(notificationId);
            // Notification'ı okundu olarak işaretle ve kaldır
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Grup daveti red hatası: {ex.Message}");
        }
    }
    public void Dispose()
    {
        if (_uiRefreshHandler != null)
            EventShop.OnUIRefreshNeeded -= _uiRefreshHandler;
        if (_receiveRequestHandler != null)
            EventShop.OnReceiveRequests -= _receiveRequestHandler;

        Console.WriteLine("🧹 RequestComponent dispose edildi.");
    }

}