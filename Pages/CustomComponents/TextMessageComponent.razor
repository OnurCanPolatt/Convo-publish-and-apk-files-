@using Domain.Entities

<div class="text-with-time @MessageFrom">
    @if (sender != null)
    {
        <p class="sender-name">@(sender.UserName ?? "Bilinmeyen")</p>
    }
    
    @if (message.Content.ToLower().StartsWith("http://") || message.Content.ToLower().StartsWith("https://"))
    {
        <p class="text">
            <a href="@message.Content" target="_blank" rel="noopener noreferrer">@message.Content</a>
        </p>
    }
    else
    {
        <p class="text">@message.Content</p>
    }
    
    <p class="time">@message.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
</div>

@code {
    [Parameter] public Message message { get; set; } = new();
    [Parameter] public string MessageFrom { get; set; } = "";
    [Parameter] public AppUser? sender { get; set; }
}

<style>
    .text-with-time {
        display: flex;
        flex-direction: column;
        max-width: 65%;
    }

    /* Received messages (sol taraf - varsayılan) */
    .text-with-time .text {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 14px 18px;
        border-radius: 18px 18px 18px 4px;
        margin: 0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        word-wrap: break-word;
        line-height: 1.4;
    }
    
    .text-with-time .text a {
        color: #007bff;
        text-decoration: underline;
        word-break: break-all;
    }

    .text-with-time .time {
        font-size: 11px;
        color: #6c757d;
        margin-top: 6px;
        margin-left: 18px;
        font-weight: 500;
    }

    .text-with-time .sender-name {
        font-weight: 600;
        font-size: 12px;
        color: #666;
        margin: 0 0 4px 18px;
    }

    /* Sent messages (sağ taraf - MAVİ) */
    .text-with-time.sent .text {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        border-radius: 18px 18px 4px 18px;
        box-shadow: 0 3px 8px rgba(0, 123, 255, 0.3);
        border: none;
    }
    
    .text-with-time.sent .text a {
        color: white;
        text-decoration: underline;
    }

    .text-with-time.sent .time {
        margin-left: 0;
        margin-right: 18px;
        text-align: right;
    }

    .text-with-time.sent .sender-name {
        margin-left: 0;
        margin-right: 18px;
        text-align: right;
    }
</style>